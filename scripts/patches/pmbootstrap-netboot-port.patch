@@ -48,13 +48,15 @@ def start_nbd_server(device: str, replace: bool, ip: str = "172.16.42.2", port:
     while True:
         logging.info("Waiting for postmarketOS device to appear...")
 
-        # Try to bind to the IP ourselves before handing it to nbd-servere
+        # Try to bind to the IP ourselves before handing it to nbd-server.
         # This is purely to improve the UX as nbd-server just quits when it
-        # cannot bind to an IP address.
+        # cannot bind to an IP address.  Port 0 keeps the probe off every
+        # fixed NBD port, so a baseline server on 9999 and an isolated
+        # candidate server on another port do not trip over each other.
         test_socket = socket.socket()
         while True:
             try:
-                test_socket.bind((ip, 9998))
+                test_socket.bind((ip, 0))
             except OSError as e:
                 if e.errno != 99:  # Cannot assign requested address
                     raise
