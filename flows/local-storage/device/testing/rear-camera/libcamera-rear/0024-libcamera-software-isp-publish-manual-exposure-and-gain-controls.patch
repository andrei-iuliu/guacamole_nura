+void Agc::queueRequest(IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	auto &ae = context.activeState.ae;
+	const auto &agc = context.activeState.agc;
+	const auto &limits = context.configuration.agc;
+
+	/*
+	 * Switching to manual holds the value in use until the application
+	 * sets one.
+	 */
+	if (const auto mode = controls.get(controls::ExposureTimeMode)) {
+		const bool manual = *mode == controls::ExposureTimeModeManual;
+		if (manual && !ae.manualExposure)
+			ae.exposure = agc.valid ? agc.exposure : limits.exposureMax;
+		ae.manualExposure = manual;
+	}
+
+	if (const auto mode = controls.get(controls::AnalogueGainMode)) {
+		const bool manual = *mode == controls::AnalogueGainModeManual;
+		if (manual && !ae.manualGain)
+			ae.gain = agc.valid ? agc.again : limits.againMin;
+		ae.manualGain = manual;
+	}
+
+	const double lineDuration = limits.lineDuration.get<std::micro>();
+	if (const auto exposureTime = controls.get(controls::ExposureTime);
+	    exposureTime && lineDuration > 0) {
+		const auto lines = static_cast<int32_t>(std::lround(*exposureTime / lineDuration));
+		ae.exposure = std::clamp(lines, limits.exposureMin, limits.exposureMax);
+	}
+
+	if (const auto gain = controls.get(controls::AnalogueGain))
+		ae.gain = std::clamp(static_cast<double>(*gain), limits.againMin,
+				     limits.againMax);
+
+	if (const auto ev = controls.get(controls::ExposureValue))
+		ae.ev = std::clamp(*ev, kExposureValueMin, kExposureValueMax);
+
+	LOG(IPASoftExposure, Debug)
+		<< "Exposure " << (ae.manualExposure ? "manual " : "auto ") << ae.exposure
+		<< ", gain " << (ae.manualGain ? "manual " : "auto ") << ae.gain
+		<< ", EV " << ae.ev;
+}
+
+double Agc::target(const IPAContext &context) const
+{
+	/*
+	 * The mean sample value grows about linearly with the exposure above
+	 * the first bin, so an EV scales that part of the target.
+	 */
+	const double scaled = (exposureTarget_ - 1.0) *
+			      std::exp2(context.activeState.ae.ev) + 1.0;
+
+	return std::clamp(scaled, 1.0, static_cast<double>(kExposureBinsCount) - 0.5);
+}
