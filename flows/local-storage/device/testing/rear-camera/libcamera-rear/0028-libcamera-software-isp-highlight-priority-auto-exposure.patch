+/*
+ * The two exponents the image processor applies to the signal after the
+ * digital gain, from the gamma and contrast the application asks for (the
+ * knobs in IPAActiveState): the contrast S-curve's exponent and the gamma.
+ * DebayerCpu::updateGammaTable() applies them and Agc judges the output's
+ * levels through them, so the two must agree.
+ */
+inline float contrastExponent(float contrast)
+{
+	return std::tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
+}
+
+inline float gammaExponent(float gamma)
+{
+	return 1.0f / gamma;
+}
 
