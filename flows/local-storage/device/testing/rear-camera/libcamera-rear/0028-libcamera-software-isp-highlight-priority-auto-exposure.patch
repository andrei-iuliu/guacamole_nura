+void Agc::updateHighlightEv(IPAContext &context, const SwIspStats::Histogram &histogram,
+			    unsigned int first, unsigned int size, double digitalGain)
+{
+	if (!maxClipped_)
+		return;
+
+	uint64_t total = 0;
+	uint64_t nearWhite = 0;
+	int whiteFrom = -1;
+	/*
+	 * The debayer takes the black level off the signal and scales what is
+	 * left to the sensor's range before applying the digital gain, so a
+	 * bin's level is where it sits in that range. The centre of the bin
+	 * stands for it: half a bin is 1/128 of white, too little for the
+	 * shoulder to tell.
+	 */
+	const double black = static_cast<double>(first) / SwIspStats::kYHistogramSize;
+
+	/*
+	 * The histogram is of raw luma, before the white balance: a neutral
+	 * highlight's channels are not equal there, red at level/gainR and so
+	 * on, so its luma is the level it is balanced to times this factor. With
+	 * the gains of a tungsten-lit room (R 2.4, B 1.5) the factor is 0.79,
+	 * and a window whose green is at full scale reaches only 0.79 of the
+	 * histogram: judging the raw level against the white point is what kept
+	 * the loop from seeing it.
+	 */
+	const auto &gains = context.activeState.awb.gains;
+	const auto gain = [](float g) {
+		return std::clamp(static_cast<double>(g), kNeutralGainMin, kNeutralGainMax);
+	};
+	const double neutral = kLumaRed / gain(gains.r()) + kLumaGreen / gain(gains.g()) +
+			       kLumaBlue / gain(gains.b());
+
+	/* The contrast and gamma this frame is displayed with. */
+	const double contrastExp = contrastExponent(
+		context.activeState.knobs.contrast.value_or(kDefaultContrast));
+	const double gamma = gammaExponent(context.activeState.knobs.gamma);
+
+	for (unsigned int i = 0; i < size; i++) {
+		const uint64_t count = histogram[first + i];
+		const double position = static_cast<double>(first + i + 0.5) /
+					SwIspStats::kYHistogramSize;
+		const double level = (position - black) / (1.0 - black);
+
+		total += count;
+		if (neutralDisplayLevel(level, neutral, digitalGain, contrastExp,
+					gamma) >= kDisplayClip) {
+			nearWhite += count;
+			if (whiteFrom < 0)
+				whiteFrom = first + i;
+		}
+	}
+
+	if (!total)
+		return;
+
+	/*
+	 * Step the target down while too much of the output renders white, and
+	 * back up only once well under the share the tuning allows, so the loop
+	 * settles in that band instead of stepping across the threshold.
+	 */
+	const double share = static_cast<double>(nearWhite) / total;
+	double &highlightEv = context.activeState.agc.highlightEv;
+
+	if (share > *maxClipped_)
+		highlightEv = std::max(-maxHighlightEv_, highlightEv - kHighlightEvDown);
+	else if (share < *maxClipped_ / 2.0)
+		highlightEv = std::min(0.0, highlightEv + kHighlightEvUp);
+
+	LOG(IPASoftExposure, Debug)
+		<< "Near white share " << share << ", allowed " << *maxClipped_
+		<< ", neutral " << neutral << ", near white from bin "
+		<< (whiteFrom < 0 ? std::string("none") : std::to_string(whiteFrom))
+		<< ", highlight EV " << highlightEv;
+}
