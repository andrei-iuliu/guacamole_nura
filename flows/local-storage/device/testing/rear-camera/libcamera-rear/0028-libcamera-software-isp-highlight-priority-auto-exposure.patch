+/*
+ * Highlight priority. The headroom keeps the raw data of the brightest pixels
+ * below clipping, and the digital gain brings the sensor's full range back to
+ * white; a window in a dim room then still renders at or near white, as it
+ * should, while the room is exposed for. A sensor whose tuning allows it can
+ * instead give the highlights priority: when more than maxClipped of the
+ * output pixels are near white, the loop aims its target up to maxHighlightEv
+ * stops darker than the ExposureValue control asks for, so the bright part of
+ * the scene keeps its colour and the rest goes dark, as a reference phone
+ * does with a backlit window.
+ */
+static constexpr double kMaxClippedMin = 0.001;
+static constexpr double kMaxClippedMax = 0.5;
+static constexpr double kMaxHighlightEvMax = 4.0;
+static constexpr double kMaxHighlightEvDefault = 2.5;
+
+/*
+ * A pixel at or above this level of the displayed image counts as near white.
+ * 250 of 255 leaves the last steps of the display to rounding, and is where
+ * the eye stops seeing a highlight's colour.
+ */
+static constexpr double kDisplayClip = 250.0 / 255.0;
+
+/*
+ * The weights of the statistics' luma (kRedYMul and the two next to it in
+ * swstats_cpu.cpp), and the range the white balance gains are taken in: the
+ * loop clamps its own at 4, and a gain near zero would make the neutral
+ * factor below meaningless.
+ */
+static constexpr double kLumaRed = 0.299;
+static constexpr double kLumaGreen = 0.587;
+static constexpr double kLumaBlue = 0.114;
+static constexpr double kNeutralGainMin = 0.25;
+static constexpr double kNeutralGainMax = 4.0;
+
+/*
+ * Stops the target moves per update. Small enough to converge smoothly, and
+ * the share must fall to half of maxClipped before the loop takes them back,
+ * which keeps the two from chasing each other around the threshold.
+ */
+static constexpr double kHighlightEvDown = 0.25;
+static constexpr double kHighlightEvUp = 0.1;
+
+/*
+ * The digital gain and shoulder the image processor applies to a 0..1 level
+ * above black, copied from apply_digital_gain() in
+ * src/libcamera/shaders/bayer_unpacked.frag and DebayerCpu::updateGammaTable():
+ * above half of white a rational curve brings the sensor's full range to
+ * exactly white instead of clipping it. Keep the three in sync.
+ */
+static double applyDigitalGain(double level, double gain)
+{
+	if (gain <= 1.0)
+		return level;
+
+	const double x = level * gain;
+	if (x <= 0.5)
+		return x;
+
+	const double s0 = (gain - 0.5) / 0.5;
+	const double t = (x - 0.5) / (gain - 0.5);
+	return 0.5 + 0.5 * s0 * t / (1.0 + (s0 - 1.0) * t);
+}
+
+/*
+ * The contrast S-curve DebayerCpu::updateGammaTable() applies after the
+ * digital gain: 0, 0.5 and 1 stay put and the curve bends around the middle.
+ */
+static double applyContrast(double level, double contrastExp)
+{
+	if (level < 0.5)
+		return 0.5 * std::pow(level / 0.5, contrastExp);
+
+	return 1.0 - 0.5 * std::pow((1.0 - level) / 0.5, contrastExp);
+}
+
+/*
+ * What the displayed image makes of a level the statistics' histogram reports
+ * for a neutral pixel: the raw luma of a neutral highlight is the level the
+ * white balance brings it to, times the neutral factor, so divide that back
+ * out, clamp as the debayer does after the gains, and follow the chain it
+ * applies to a channel value: the digital gain with its shoulder, the
+ * contrast S-curve and the gamma. A window in the sun renders at 255 through
+ * this while its raw luma sits near 0.79 and never reaches the top bins.
+ */
+static double neutralDisplayLevel(double level, double neutral, double digitalGain,
+				  double contrastExp, double gamma)
+{
+	const double balanced = std::min(1.0, level / neutral);
+	const double gained = std::min(1.0, applyDigitalGain(balanced, digitalGain));
+
+	return std::pow(applyContrast(gained, contrastExp), gamma);
+}
