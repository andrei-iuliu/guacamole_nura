# Rear-camera test stack only; never replaces Nura's 0.8 ABI used by PipeWire.
maintainer="Nura local bring-up <nura@example.invalid>"
pkgname=libcamera-rear
pkgver=0.7.2
pkgrel=1
pkgdesc="Isolated Nura rear-camera software ISP test stack"
url="https://libcamera.org/"
arch="aarch64"
license="LGPL-2.1-or-later AND GPL-2.0-or-later"
depends="bash"
makedepends="coreutils meson ninja py3-jinja2 py3-yaml py3-ply gnutls-dev libevent-dev
	eudev-dev yaml-dev mesa-dev openssl linux-headers"
# Keep Meson's post-install IPA signatures valid: no subsequent stripping.
# The isolated local test stack deliberately lives under /opt.
options="!strip !check !fhs"
# Let abuild trace our private 0.7 libraries without a global loader change.
ldpath="/opt/nura-rear-camera/lib"
source="https://gitlab.freedesktop.org/camera/libcamera/-/archive/v$pkgver/libcamera-v$pkgver.tar.gz
	0002-libcamera-simple-Skip-hwISP-formats-if-swISP-is-acti.patch
	0003-libcamera-add-Samsung-S5K3M5-sensor-data.patch
	0004-libcamera-add-Sony-IMX586-sensor-data.patch
	0005-libcamera-software-isp-add-contrast-autofocus.patch
	0006-libcamera-add-Sony-IMX481-sensor-data.patch
	0008-libcamera-software-isp-responsive-3a-and-af-windows.patch
	0009-libcamera-software-isp-preserve-requested-agc-state.patch
	0010-libcamera-software-isp-tighten-automatic-controls.patch
	0011-libcamera-dma-buf-allocator-fall-back-to-the-system-heap.patch
	0012-libcamera-software-isp-gather-GPU-statistics-over-the-visible-input.patch
	0013-libcamera-software-isp-let-the-lens-settle-before-autofocus-samples.patch
	0014-libcamera-software-isp-take-contrast-and-saturation-defaults-from-tuning.patch
	0015-libcamera-software-isp-keep-exposure-and-white-balance-across-configurations.patch
	0016-libcamera-software-isp-fit-the-autofocus-peak-between-fine-samples.patch
	0017-libcamera-software-isp-keep-focus-across-configurations.patch
	0018-libcamera-software-isp-keep-highlights-with-exposure-headroom-and-digital-gain.patch
	0019-libcamera-software-isp-keep-highlights-clipped-in-every-channel-white.patch
	0020-libcamera-software-isp-steadier-continuous-autofocus.patch
	0021-libcamera-software-isp-start-autofocus-scans-on-settled-exposure.patch
	0023-libcamera-software-isp-take-the-exposure-target-from-tuning.patch
	0024-libcamera-software-isp-publish-manual-exposure-and-gain-controls.patch
	0025-libcamera-software-isp-leave-clipped-pixels-out-of-white-balance.patch
	0026-libcamera-software-isp-add-radial-lens-shading-correction.patch
	0027-libcamera-software-isp-apply-lens-shading-to-the-statistics.patch
	cam-rear
	imx586.yaml
	imx481.yaml
	s5k3m5.yaml
"
builddir="$srcdir/libcamera-v$pkgver"

build() {
	abuild-meson --prefix=/opt/nura-rear-camera --libdir=lib \
		--bindir=bin --sbindir=sbin --libexecdir=libexec --includedir=include \
		--datadir=share --mandir=share/man --infodir=share/info \
		--localedir=share/locale --sysconfdir=etc \
		-Dpipelines=simple -Dipas=simple -Dsoftisp-gpu=enabled \
		-Dcam=enabled -Dcam-output-kms=disabled -Dcam-output-sdl2=disabled \
		-Dcam-jpeg=disabled -Dapps-output-dng=disabled \
		-Dqcam=disabled -Dgstreamer=disabled -Dpycamera=disabled \
		-Ddocumentation=disabled -Dlc-compliance=disabled -Dtracing=disabled \
		-Dv4l2=false -Dtest=false -Dlibdw=disabled -Dlibunwind=disabled \
		-Dwerror=false . output
	meson compile -C output
}

package() {
	install -Dm755 "$srcdir"/cam-rear "$pkgdir"/usr/bin/cam-rear
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 -t "$pkgdir"/opt/nura-rear-camera/share/libcamera/ipa/simple \
		"$srcdir"/imx586.yaml "$srcdir"/imx481.yaml "$srcdir"/s5k3m5.yaml
}
