+/*
+ * Radial lens shading correction. The gain of each channel is the polynomial
+ *
+ *   gain_c(r) = k0 + k1*r^2 + k2*r^4 + k3*r^6
+ *
+ * where r is the distance from the lens centre, normalised so that r = 1 at
+ * the corners of the sensor image, as the flat-field fit of the falloff used.
+ *
+ * lscCentre is in pixels of the input image and lscScale is 4 / (W^2 + H^2)
+ * for that image, so a position sampled from the full sensor keeps the fit
+ * even when the output stream is scaled down.
+ */
+uniform bool lscEnabled;
+uniform vec2 lscCentre;
+uniform vec4 lscR;
+uniform vec4 lscG;
+uniform vec4 lscB;
+uniform float lscStrength;
+uniform float lscMaxGain;
+uniform float lscScale;
