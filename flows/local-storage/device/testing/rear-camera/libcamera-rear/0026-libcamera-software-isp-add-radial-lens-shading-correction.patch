@@ -103,6 +124,30 @@ float apply_contrast(float value)
 		return 1.0 - 0.5 * pow((1.0 - value) / 0.5, contrastExp);
 }
 
+/* k0 + k1*r^2 + k2*r^4 + k3*r^6, evaluated with Horner's rule */
+float lsc_gain(vec4 k, float r2)
+{
+	return k.x + r2 * (k.y + r2 * (k.z + r2 * k.w));
+}
+
+/*
+ * Undo the lens falloff on the demosaiced linear signal, before the white
+ * balance gains. Multiplying before the black level came off would scale the
+ * black too and colour it.
+ */
+vec3 apply_lsc(vec3 rgb, vec2 pos)
+{
+	if (!lscEnabled)
+		return rgb;
+
+	vec2 d = pos - lscCentre;
+	float r2 = dot(d, d) * lscScale;
+	vec3 gain = vec3(lsc_gain(lscR, r2), lsc_gain(lscG, r2),
+			 lsc_gain(lscB, r2));
+	gain = vec3(1.0) + lscStrength * (gain - vec3(1.0));
+	return rgb * clamp(gain, vec3(1.0 / lscMaxGain), vec3(lscMaxGain));
+}
