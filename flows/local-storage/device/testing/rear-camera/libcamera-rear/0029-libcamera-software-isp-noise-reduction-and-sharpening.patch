diff --git a/src/ipa/simple/algorithms/detail.cpp b/src/ipa/simple/algorithms/detail.cpp
new file mode 100644
index 0000000..7eb4a15
--- /dev/null
+++ b/src/ipa/simple/algorithms/detail.cpp
@@ -0,0 +1,131 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Noise reduction and sharpening, from the tuning file's Detail section
+ *
+ * The stages themselves are Omarchy Mobile's (LGPL-2.1-or-later, Copyright
+ * (C) 2026 Derek Ross), which this follows step for step, as does the CPU port
+ * in omacam's omacam-merge (isp.rs, Detail::for_gain): a burst finished there
+ * and a live frame come out of the same filter with the same strengths.
+ */
+
+#include "detail.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/software_isp/debayer_params.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftDetail)
+
+namespace {
+
+/*
+ * The range sigmas stop where the filter would smooth past the noise, and the
+ * Sharpness control runs to four times the tuning file's amount.
+ */
+constexpr float kDenoiseMax = 0.15f;
+constexpr float kChromaDenoiseMax = 0.25f;
+constexpr float kSharpnessMax = 4.0f;
+
+} /* namespace */
+
+/**
+ * \class Detail
+ * \brief Luma and chroma noise reduction and sharpening, scaled with the gain
+ *
+ * The GPU debayer's second pass smooths the luma with an edge-preserving
+ * (bilateral) 3x3 filter and sharpens it with an unsharp mask cored by the
+ * noise level. It also averages the chroma over a 9x9 footprint, guided by the
+ * luma and the chroma, for the blotchy colour noise of high gains. Noise grows
+ * with the gain, so the smoothing grows with it and the sharpening falls:
+ *
+ *   denoise = denoise_base * sqrt(gain), at most 0.15
+ *   chroma_denoise = chroma_denoise_base * sqrt(gain), at most 0.25
+ *   sharpen = sharpen_base * Sharpness / (1 + log2(gain) / 3)
+ *
+ * where gain is the analogue gain times the digital gain. The tuning file gives
+ * the bases, and no Detail section leaves the picture untouched:
+ *
+ *   - Detail:
+ *       sharpen: 0.6
+ *       denoise: 0.015
+ *       chromaDenoise: 0.03
+ */
+
+int Detail::init(IPAContext &context, const ValueNode &tuningData)
+{
+	/*
+	 * A missing key is a strength of zero, so a section that names only
+	 * some of them leaves the picture untouched by the others.
+	 */
+	sharpenBase_ = std::max(tuningData["sharpen"].get<float>(0.0f), 0.0f);
+	denoiseBase_ = std::max(tuningData["denoise"].get<float>(0.0f), 0.0f);
+	chromaDenoiseBase_ =
+		std::max(tuningData["chromaDenoise"].get<float>(0.0f), 0.0f);
+
+	context.ctrlMap[&controls::Sharpness] =
+		ControlInfo(0.0f, kSharpnessMax, 1.0f);
+
+	return 0;
+}
+
+void Detail::queueRequest([[maybe_unused]] typename Module::Context &context,
+			  [[maybe_unused]] const uint32_t frame,
+			  [[maybe_unused]] typename Module::FrameContext &frameContext,
+			  const ControlList &controls)
+{
+	const auto &sharpness = controls.get(controls::Sharpness);
+	if (sharpness.has_value()) {
+		sharpness_ = std::clamp(*sharpness, 0.0f, kSharpnessMax);
+		LOG(IPASoftDetail, Debug) << "Setting sharpness to " << sharpness_;
+	}
+}
+
+void Detail::prepare(IPAContext &context,
+		     [[maybe_unused]] const uint32_t frame,
+		     [[maybe_unused]] IPAFrameContext &frameContext,
+		     DebayerParams *params)
+{
+	/*
+	 * The gain the sensor's signal is multiplied by: the analogue gain it
+	 * gets, which is the loop's own once the headroom came off, times the
+	 * digital gain that brings the headroom back.
+	 */
+	const auto &agc = context.activeState.agc;
+	const auto &limits = context.configuration.agc;
+	const double digitalGain = std::exp2(agc.headroom);
+	const double again = std::clamp(agc.again / digitalGain,
+					limits.againMin, limits.againMax);
+	const double gain = std::max(1.0, again * std::max(digitalGain, 1.0));
+
+	params->denoise = std::min(static_cast<float>(denoiseBase_ * std::sqrt(gain)),
+				   kDenoiseMax);
+	params->chromaDenoise =
+		std::min(static_cast<float>(chromaDenoiseBase_ * std::sqrt(gain)),
+			 kChromaDenoiseMax);
+	params->sharpen = static_cast<float>(sharpenBase_ * sharpness_ /
+					     (1.0 + std::log2(gain) / 3.0));
+}
+
+void Detail::process([[maybe_unused]] IPAContext &context,
+		     [[maybe_unused]] const uint32_t frame,
+		     [[maybe_unused]] IPAFrameContext &frameContext,
+		     [[maybe_unused]] const SwIspStats *stats,
+		     ControlList &metadata)
+{
+	metadata.set(controls::Sharpness, sharpness_);
+}
+
+REGISTER_IPA_ALGORITHM(Detail, "Detail")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
