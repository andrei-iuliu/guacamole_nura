+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Noise reduction and sharpening, for the GPU debayer's second pass
+ */
+
+#pragma once
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Detail : public Algorithm
+{
+public:
+	Detail() = default;
+	~Detail() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void queueRequest(typename Module::Context &context,
+			  const uint32_t frame,
+			  typename Module::FrameContext &frameContext,
+			  const ControlList &controls) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	/* The tuning file's strengths at a gain of 1. */
+	float sharpenBase_ = 0.0f;
+	float denoiseBase_ = 0.0f;
+	float chromaDenoiseBase_ = 0.0f;
+	/* The Sharpness control: 1 leaves the tuning file's amount. */
+	float sharpness_ = 1.0f;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
