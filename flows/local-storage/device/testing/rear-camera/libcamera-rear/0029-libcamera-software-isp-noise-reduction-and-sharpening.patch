 void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerParams &params)
 {
+	/* The second pass leaves its own program current */
+	egl_.useProgram(programId_);
+
 	/*
 	 * Raw Bayer 8-bit, and packed raw Bayer 10-bit/12-bit formats
 	 * are stored in a GL_LUMINANCE texture. The texture width is
@@ -634,6 +641,124 @@ eGLImage *DebayerEGL::getCachedOutputFrameBuffer(FrameBuffer *output)
 	return eglImageOut;
 }
 
+/*
+ * The second pass, noise reduction and sharpening, takes the debayered picture
+ * from postImage_. Without it (a compile failure, say) the debayer renders
+ * straight to the output, as it does when no tuning asks for any of the three
+ * strengths.
+ */
+int DebayerEGL::initPostShaders()
+{
+	std::vector<std::string> shaderEnv;
+	GLuint vertexShaderId = 0;
+	GLuint fragmentShaderId = 0;
+
+	egl_.pushEnv(shaderEnv, "#version 100");
+
+	if (egl_.compileVertexShader(vertexShaderId, identity_vert, shaderEnv))
+		return -ENODEV;
+	utils::scope_exit vShaderGuard([&] { glDeleteShader(vertexShaderId); });
+
+	if (egl_.compileFragmentShader(fragmentShaderId, postfilter_frag, shaderEnv))
+		return -ENODEV;
+	utils::scope_exit fShaderGuard([&] { glDeleteShader(fragmentShaderId); });
+
+	if (egl_.linkProgram(postProgramId_, vertexShaderId, fragmentShaderId))
+		return -ENODEV;
+
+	postAttributeVertex_ = glGetAttribLocation(postProgramId_, "vertexIn");
+	postAttributeTexture_ = glGetAttribLocation(postProgramId_, "textureIn");
+	postUniformTexture_ = glGetUniformLocation(postProgramId_, "tex_rgb");
+	postUniformStep_ = glGetUniformLocation(postProgramId_, "tex_step");
+	postUniformSharpen_ = glGetUniformLocation(postProgramId_, "sharpen");
+	postUniformDenoise_ = glGetUniformLocation(postProgramId_, "denoise");
+	postUniformChromaDenoise_ = glGetUniformLocation(postProgramId_, "chroma_denoise");
+	postUniformSwapBlue_ = glGetUniformLocation(postProgramId_, "swap_blue");
+	postUniformProjMatrix_ = glGetUniformLocation(postProgramId_, "proj_matrix");
+	postUniformStrideFactor_ = glGetUniformLocation(postProgramId_, "stride_factor");
+
+	LOG(Debayer, Debug) << "post tex_rgb " << postUniformTexture_
+			    << " tex_step " << postUniformStep_
+			    << " sharpen " << postUniformSharpen_
+			    << " denoise " << postUniformDenoise_
+			    << " chroma_denoise " << postUniformChromaDenoise_;
+
+	return 0;
+}
+
+/*
+ * The intermediate texture, of the output size the first pass renders into
+ * and the second reads. Made on the first frame that wants the second pass, so
+ * that a camera whose tuning has no Detail section pays no memory for it.
+ */
+int DebayerEGL::ensurePostPass()
+{
+	if (postImage_)
+		return 0;
+
+	postImage_ = std::make_unique<eGLImage>(GL_RGBA, outputSize_.width,
+					       outputSize_.height,
+					       outputSize_.width * 4, GL_TEXTURE2, 2);
+	egl_.createOutputTexture2D(*postImage_);
+
+	if (egl_.attachTextureToFBO(*postImage_)) {
+		postImage_.reset();
+		return -ENODEV;
+	}
+
