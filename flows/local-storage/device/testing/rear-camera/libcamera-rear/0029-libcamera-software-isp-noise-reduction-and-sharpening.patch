diff --git a/src/libcamera/shaders/postfilter.frag b/src/libcamera/shaders/postfilter.frag
new file mode 100644
index 0000000..87ecb95
--- /dev/null
+++ b/src/libcamera/shaders/postfilter.frag
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Luma and chroma noise reduction and sharpening: the second pass of the GPU
+ * debayer, over the display-encoded RGB the first pass writes.
+ *
+ * Ported from Omarchy Mobile's libcamera ("debayer_egl: Add a noise reduction
+ * and sharpening pass" and "debayer_egl: Smooth the chroma"), LGPL-2.1-or-later:
+ * Copyright (C) 2026 Derek Ross.
+ *
+ * The luma is smoothed by a 3x3 bilateral filter (a binomial blur weighted by
+ * the difference in luma, so edges keep their contrast) and sharpened by an
+ * unsharp mask cored by the noise level. The chroma is averaged over a 9x9
+ * footprint weighted by the luma and the chroma, which is where the blotchy
+ * colour noise of a high gain goes. Colour is BT.601 luma with the two colour
+ * differences, and 0 in a strength leaves that part alone.
+ */
+
+#ifdef GL_ES
+precision highp float;
+#endif
+
+varying vec2 textureOut;
+
+/* The first pass's output: display-encoded RGB in 0..1 */
+uniform sampler2D tex_rgb;
+/* One output pixel, in texture coordinates */
+uniform vec2 tex_step;
+/* Unsharp mask amount on the luma, 0 leaves it */
+uniform float sharpen;
+/* Range sigma of the luma smoothing, 0 leaves it */
+uniform float denoise;
+/* Range sigma of the chroma smoothing, 0 leaves the chroma */
+uniform float chroma_denoise;
+/* 1.0 to write blue first */
+uniform float swap_blue;
+
+float luma(vec3 c)
+{
+	return dot(c, vec3(0.299, 0.587, 0.114));
+}
+
+void main(void)
+{
+	vec3 c = texture2D(tex_rgb, textureOut).rgb;
+	float y = luma(c);
+
+	/*
+	 * The 3x3 neighbourhood: a binomial blur for the unsharp mask, and the
+	 * same weights scaled down by the difference in luma for the bilateral
+	 * smoothing.
+	 */
+	float blur = 4.0 * y;
+	float smooth_sum = 4.0 * y;
+	float smooth_weight = 4.0;
+	float inv_sigma = denoise > 0.0 ? 1.0 / denoise : 0.0;
+
+	for (int j = -1; j <= 1; j++) {
+		for (int i = -1; i <= 1; i++) {
+			if (i == 0 && j == 0)
+				continue;
+
+			vec2 offset = vec2(float(i), float(j)) * tex_step;
+			float yn = luma(texture2D(tex_rgb, textureOut + offset).rgb);
+			float w = (i == 0 || j == 0) ? 2.0 : 1.0;
+			float d = (yn - y) * inv_sigma;
+			float ws = w * exp(-d * d);
+
+			blur += w * yn;
+			smooth_sum += ws * yn;
+			smooth_weight += ws;
+		}
+	}
+	blur /= 16.0;
+
+	float y_out = denoise > 0.0 ? smooth_sum / smooth_weight : y;
+
+	/* Sharpen detail above the noise only (coring) */
+	float detail = y - blur;
+	detail = sign(detail) * max(abs(detail) - 0.5 * denoise, 0.0);
+	y_out = clamp(y_out + sharpen * detail, 0.0, 1.0);
+
+	vec3 rgb = c + (y_out - y);
+
+	if (chroma_denoise > 0.0) {
+		/*
+		 * Colour noise is blotchy, coarser than the 3x3 above: average
+		 * the chroma over a 9x9 footprint (16 taps at 2 and 4 pixels in
+		 * eight directions), guided by the luma so that colour doesn't
+		 * bleed across edges, and by the chroma itself so that real
+		 * colour detail survives.
+		 */
+		vec2 cc = vec2(c.b - y, c.r - y);
+		vec2 c_sum = cc;
+		float c_weight = 1.0;
+		float inv_c = 1.0 / chroma_denoise;
+		float inv_y = 1.0 / (0.04 + 2.0 * denoise);
+
+		for (int k = 0; k < 16; k++) {
+			float a = float(k) * 0.7853982;
+			float rad = k < 8 ? 2.0 : 4.0;
+			vec2 offset = vec2(cos(a), sin(a)) * rad * tex_step;
+			vec3 cn = texture2D(tex_rgb, textureOut + offset).rgb;
+			float yn = luma(cn);
+			vec2 ccn = vec2(cn.b - yn, cn.r - yn);
+			float dy = (yn - y) * inv_y;
+			vec2 dc = (ccn - cc) * inv_c;
+			float w = (k < 8 ? 1.0 : 0.6) * exp(-dy * dy - dot(dc, dc));
+
+			c_sum += w * ccn;
+			c_weight += w;
+		}
+		cc = c_sum / c_weight;
+
+		/* Rebuild RGB from the luma and the smoothed colour differences */
+		rgb.b = y_out + cc.x;
+		rgb.r = y_out + cc.y;
+		rgb.g = (y_out - 0.299 * rgb.r - 0.114 * rgb.b) / 0.587;
+	}
+
+	rgb = clamp(rgb, 0.0, 1.0);
+	gl_FragColor = vec4(mix(rgb, rgb.bgr, swap_blue), 1.0);
+}
