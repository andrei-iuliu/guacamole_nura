+/**
+ * \brief Set the lens shading correction to apply to the statistics
+ * \param[in] lsc The correction, as the debayer applies it
+ * \param[in] blackLevel The black level the signal starts above
+ *
+ * The exposure, the white balance and the luminance histogram must see the
+ * frame the debayer produces. Without this, a correction that brightens the
+ * corners by more than three times leaves them out of the exposure loop and
+ * clips anything bright near the edge of the frame.
+ *
+ * Like the shaders, the gain multiplies the signal above the black level and
+ * leaves the level itself in place, so that the white balance can subtract it
+ * from the sums and the black stays out of the histogram as it is without the
+ * correction.
+ *
+ * The correction is static for a camera session, so the gain table is built
+ * here, from the values passed in, and only when they differ from the ones in
+ * use. The autofocus statistics are left on the raw data.
+ */
+void SwStatsCpu::setLensShading(const DebayerParams::LensShading &lsc,
+				const RGB<float> &blackLevel)
+{
+	bool same = lsc_.enabled == lsc.enabled &&
+		    lsc_.strength == lsc.strength &&
+		    lsc_.maxGain == lsc.maxGain &&
+		    lsc_.centre[0] == lsc.centre[0] &&
+		    lsc_.centre[1] == lsc.centre[1] &&
+		    blackLevel_ == blackLevel;
+
+	for (unsigned int channel = 0; channel < 3 && same; channel++)
+		same = std::equal(std::begin(lsc_.coefficients[channel]),
+				  std::end(lsc_.coefficients[channel]),
+				  std::begin(lsc.coefficients[channel]));
+
+	if (same)
+		return;
+
+	lsc_ = lsc;
+	blackLevel_ = blackLevel;
+
+	if (!lsc_.enabled) {
+		lscEnabled_ = false;
+		return;
+	}
+
+	buildLensShadingGains();
+	/* Only sample the table when it holds a gain for every block. */
+	lscEnabled_ = !lscGain_.empty();
+}
+
+/*
+ * Build the per-channel gain of every block of the input image, in
+ * 1 / (1 << kLscGainShift) units, with the same formula, strength and clamp as
+ * the shaders: the gain is fitted in fractions of the image size, normalised
+ * so that r = 1 at the corners of a centred lens.
+ *
+ * The black level is carried in fractions of the sensor range, and the pixel
+ * values are in 8-bit units times the divisor of the input format, which the
+ * sums are shifted back by in finishFrame(). Convert it once here rather than
+ * per sample.
+ */
+void SwStatsCpu::buildLensShadingGains()
+{
+	if (!inputSize_.width || !inputSize_.height)
+		return;
+
+	const unsigned int maxLevel = 255 * (1U << sumShift_);
+
+	for (unsigned int channel = 0; channel < 3; channel++) {
+		const long level = std::lround(blackLevel_[channel] * 255.0f *
+					       (1U << sumShift_));
+		lscBlack_[channel] = static_cast<unsigned int>(
+			std::clamp<long>(level, 0, maxLevel));
+	}
+
+	const float width = inputSize_.width;
+	const float height = inputSize_.height;
+	const float scale = 4.0f / (width * width + height * height);
+	const float centreX = lsc_.centre[0] * width;
+	const float centreY = lsc_.centre[1] * height;
+	const float maxGain = std::max(lsc_.maxGain, 1.0f);
+	const float minGain = 1.0f / maxGain;
+	constexpr float blockCentre = kLscBlockSize / 2.0f;
+
+	/*
+	 * One block row more than the image has, so that a caller passing a
+	 * window that reaches just past the last line still reads a gain
+	 * instead of the heap.
+	 */
+	lscGain_.resize(lscBlockWidth_ * (lscBlockHeight_ + 1) * 3);
+
+	for (unsigned int blockY = 0; blockY <= lscBlockHeight_; blockY++) {
+		const float dy = blockY * kLscBlockSize + blockCentre - centreY;
+
+		for (unsigned int blockX = 0; blockX < lscBlockWidth_; blockX++) {
+			const float dx = blockX * kLscBlockSize + blockCentre - centreX;
+			const float r2 = (dx * dx + dy * dy) * scale;
+			uint16_t *gains = &lscGain_[(blockY * lscBlockWidth_ + blockX) * 3];
+
+			for (unsigned int channel = 0; channel < 3; channel++) {
+				const float *k = lsc_.coefficients[channel];
+				float gain = k[0] + r2 * (k[1] + r2 * (k[2] + r2 * k[3]));
+
+				gain = 1.0f + lsc_.strength * (gain - 1.0f);
+				gain = std::clamp(gain, minGain, maxGain);
+				gains[channel] = static_cast<uint16_t>(std::clamp<long>(
+					std::lround(gain * (1 << kLscGainShift)),
+					0, UINT16_MAX));
+			}
+		}
+	}
+
+	LOG(SwStatsCpu, Debug)
+		<< "Lens shading gain table of " << lscBlockWidth_ << "x"
+		<< lscBlockHeight_ << " blocks for the statistics";
+}
