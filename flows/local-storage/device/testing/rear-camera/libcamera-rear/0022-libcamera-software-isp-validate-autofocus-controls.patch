+/*
+ * Applications can send a control with the wrong type, or an array where a
+ * scalar is expected: the typed get() of a ControlList asserts on both, which
+ * aborts the whole camera process. Check the value first and ignore a
+ * malformed one, leaving the algorithm in its previous state.
+ */
+template<typename T>
+static std::optional<T> requestControl(const ControlList &requestControls,
+				       const Control<T> &control)
+{
+	if (!requestControls.contains(control.id()))
+		return std::nullopt;
+
+	const ControlValue &value = requestControls.get(control.id());
+	const ControlId &ctrlId = control;
+	if (value.type() != ctrlId.type() || value.isArray()) {
+		LOG(IPASoftAf, Warning)
+			<< "Ignoring malformed " << ctrlId.name();
+		return std::nullopt;
+	}
+
+	return value.get<T>();
+}
+
+/*
+ * An array control sent with a single element can arrive as a scalar value,
+ * which libcamera-rs does for AfWindows: accept it as a list of one window,
+ * stored in @scalar.
+ */
+static std::optional<Span<const Rectangle>>
+requestWindows(const ControlList &requestControls, Rectangle &scalar)
+{
+	if (!requestControls.contains(controls::AfWindows.id()))
+		return std::nullopt;
+
+	const ControlValue &value =
+		requestControls.get(controls::AfWindows.id());
+	if (value.type() != ControlTypeRectangle) {
+		LOG(IPASoftAf, Warning) << "Ignoring malformed AfWindows";
+		return std::nullopt;
+	}
+
+	if (value.isArray())
+		return value.get<Span<const Rectangle>>();
+
+	scalar = value.get<Rectangle>();
+	return Span<const Rectangle>(&scalar, 1);
+}
+
