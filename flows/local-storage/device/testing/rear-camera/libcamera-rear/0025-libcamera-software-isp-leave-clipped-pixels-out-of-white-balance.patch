libcamera: software_isp: leave clipped pixels out of white balance

Grey-world white balance summed every sampled pixel. Clipped pixels read
the same in all channels whatever the light, so a bright window or sky
pulled the red and blue gains towards 1 and the whole picture went green
(the sensor's raw green is about twice red and blue). The statistics now
also sum only pixels with no channel at or above 240 (8-bit scale), and
AWB uses those, falling back to all pixels when under 2% of the frame is
left.
---
diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index e0213ed..395261e 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -31,6 +31,20 @@ struct SwIspStats {
 	 * \brief Sums of colour channels of all the sampled pixels
 	 */
 	RGB<uint64_t> sum_;
+	/**
+	 * \brief Sums of colour channels of the sampled pixels that have no
+	 *        channel at or above SwIspStats::kAwbSaturation, for white balance
+	 */
+	RGB<uint64_t> awbSum_;
+	/**
+	 * \brief Number of sampled pixels included in awbSum_
+	 */
+	uint64_t awbPixels;
+	/**
+	 * \brief Channel level (8-bit scale) from which a pixel is treated as
+	 *        clipped and left out of awbSum_
+	 */
+	static constexpr unsigned int kAwbSaturation = 240;
 	/**
 	 * \brief Number of bins in the yHistogram
 	 */
diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index 5f13c13..e9b7554 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -67,13 +67,22 @@ void Awb::process(IPAContext &context,
 	 */
 	const uint64_t nPixels = std::accumulate(
 		histogram.begin(), histogram.end(), uint64_t(0));
-	const uint64_t offset = blackLevel * nPixels;
+	/*
+	 * Leave clipped pixels out: they read equal in all channels whatever
+	 * the light, so a bright window or sky pulls the gains towards 1 and
+	 * the whole picture goes green. Fall back to all pixels only when
+	 * almost nothing is left (a frame that is nearly all clipped).
+	 */
+	const bool useUnclipped = stats->awbPixels * 50 >= nPixels;
+	const uint64_t n = useUnclipped ? stats->awbPixels : nPixels;
+	const RGB<uint64_t> &rawSum = useUnclipped ? stats->awbSum_ : stats->sum_;
+	const uint64_t offset = blackLevel * n;
 	const uint64_t minValid = 1;
 	/*
 	 * Make sure the sums are at least minValid, while preventing unsigned
 	 * integer underflow.
 	 */
-	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;
+	const RGB<uint64_t> sum = rawSum.max(offset + minValid) - offset;
 
 	/*
 	 * Calculate red and blue gains for AWB.
