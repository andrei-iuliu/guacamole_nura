+/* Choose the 1-based physical slot to expose as the primary SIM.
+ *
+ * ModemManager's card-status parser already defines "the SIM to use" as the one
+ * identified by the Primary GW session (mm-modem-helpers-qmi.c), and UIM Read
+ * Transparent follows that same PRIMARY_GW_PROVISIONING session. A firmware that
+ * reports two ACTIVE physical slots does not identify that session through the
+ * Get Slot Status order alone (ModemManager kept the last ACTIVE slot, qmicli
+ * keeps the first).
+ *
+ * The Primary GW index is only trusted while its physical slot is ACTIVE and a
+ * SIM object was actually built for it: a stale session index or a failed ICCID
+ * parse must not override the current slot. When the mapping is unknown or
+ * unusable, fall back to exactly the previous behaviour (last ACTIVE slot), so
+ * single-SIM and no-card policy is unchanged.
+ *
+ * Pure gboolean/guint arithmetic on purpose: the regression test compiles this
+ * function standalone with the host C compiler.
+ */
+static guint
+select_primary_sim_slot (guint          n_slots,
+                         const gboolean *slot_active,
+                         const gboolean *slot_sim_constructed,
+                         guint           gw_primary_slot)
+{
+    guint i;
+    guint last_active = 0;
+
+    if (gw_primary_slot >= 1 && gw_primary_slot <= n_slots &&
+        slot_active[gw_primary_slot - 1] &&
+        slot_sim_constructed[gw_primary_slot - 1])
+        return gw_primary_slot;
+
+    for (i = 1; i <= n_slots; i++) {
+        if (slot_active[i - 1])
+            last_active = i;
+    }
+
+    return last_active;
+}
