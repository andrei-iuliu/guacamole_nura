+static void
+load_sim_slots_get_card_status_ready (QmiClientUim *client,
+                                      GAsyncResult *res,
+                                      GTask        *task)
+{
+    g_autoptr(QmiMessageUimGetCardStatusOutput) output = NULL;
+    g_autoptr(GError)                           error = NULL;
+    LoadSimSlotsContext                        *ctx;
+    guint16                                     index_gw_primary = 0xFFFF;
+    GArray                                     *cards = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    output = qmi_client_uim_get_card_status_finish (client, res, &error);
+    if (!output ||
+        !qmi_message_uim_get_card_status_output_get_result (output, &error) ||
+        !qmi_message_uim_get_card_status_output_get_card_status (
+            output,
+            &index_gw_primary,
+            NULL, /* index_1x_primary */
+            NULL, /* index_gw_secondary */
+            NULL, /* index_1x_secondary */
+            &cards,
+            NULL)) {
+        mm_obj_dbg (g_task_get_source_object (task),
+                    "couldn't read primary GW session for SIM slot selection: %s",
+                    error ? error->message : "unknown error");
+    } else if (index_gw_primary != 0xFFFF) {
+        /* High byte is the 0-based physical slot, low byte the 0-based
+         * application index. The selection helper validates the bounds. */
+        ctx->gw_primary_slot = ((index_gw_primary & 0xFF00) >> 8) + 1;
+    }
+
+    qmi_client_uim_get_slot_status (ctx->client_uim,
+                                    NULL,
+                                    10,
+                                    NULL,
+                                    (GAsyncReadyCallback) uim_get_slot_status_ready,
+                                    task);
+}
