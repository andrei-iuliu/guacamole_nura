--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -357,6 +357,19 @@ config INPUT_GPIO_DECODER
 	 To compile this driver as a module, choose M here: the module
 	 will be called gpio_decoder.
 
+config INPUT_GOODIX_FP
+	tristate "Goodix optical fingerprint sensor (OnePlus downstream ABI)"
+	depends on OF && NET
+	help
+	  Power, reset and interrupt for the Goodix under-display optical
+	  fingerprint sensor of the OnePlus 7 Pro. It exposes the userspace
+	  interface of the downstream OnePlus driver (/dev/goodix_fp, netlink
+	  protocol 25, /proc/fp_id) for the stock fingerprint HAL. It does not
+	  read fingerprints: the sensor's data path belongs to a TrustZone app.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called goodix_fp.
+
 config INPUT_GPIO_VIBRA
 	tristate "GPIO vibrator support"
 	depends on GPIOLIB || COMPILE_TEST
