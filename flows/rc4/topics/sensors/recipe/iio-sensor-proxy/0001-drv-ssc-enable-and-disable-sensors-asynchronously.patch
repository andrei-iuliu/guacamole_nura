diff --git a/src/drv-ssc-light.c b/src/drv-ssc-light.c
index 27c819f..46d1b26 100644
--- a/src/drv-ssc-light.c
+++ b/src/drv-ssc-light.c
@@ -44,6 +44,28 @@ ssc_light_discover (GUdevDevice *device)
 	return TRUE;
 }
 
+static void
+light_open_done (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	SSCSensorLight *sensor = SSC_SENSOR_LIGHT (source);
+	g_autoptr(GError) error = NULL;
+
+	if (!ssc_sensor_light_open_finish (sensor, result, &error))
+		g_warning ("Opening SSC light sensor failed: %s",
+		           error ? error->message : "UNKNOWN");
+}
+
+static void
+light_close_done (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	SSCSensorLight *sensor = SSC_SENSOR_LIGHT (source);
+	g_autoptr(GError) error = NULL;
+
+	if (!ssc_sensor_light_close_finish (sensor, result, &error))
+		g_warning ("Closing SSC light sensor failed: %s",
+		           error ? error->message : "UNKNOWN");
+}
+
 static void
 measurement_cb (SSCSensorLight *sensor, gfloat intensity, gpointer user_data)
 {
@@ -81,7 +103,6 @@ static void
 ssc_light_set_polling (SensorDevice *sensor_device, gboolean state)
 {
 	DrvData *drv_data = (DrvData *) sensor_device->priv;
-	g_autoptr (GError) error = NULL;
 	if (state) {
 		if (drv_data->measurement_id)
 			return;
@@ -90,9 +111,17 @@ ssc_light_set_polling (SensorDevice *sensor_device, gboolean state)
 					                     "measurement",
 							     G_CALLBACK (measurement_cb),
 							     sensor_device);
-		/* Enable sensor */
-		if (!ssc_sensor_light_open_sync (drv_data->sensor, NULL, &error))
-			g_warning ("Opening SSC light sensor failed: %s", error->message);
+		/*
+		 * Enable the sensor asynchronously.  The *_sync() helpers iterate
+		 * the application's main context recursively while they wait, so
+		 * calling one from this D-Bus method call handler re-enters the
+		 * handler and dispatches the next pending method call (another
+		 * Claim*() of the same client) inside the wait.  libssc's wait
+		 * also polls without blocking, so every millisecond spent waiting
+		 * burns a whole CPU core.  The first reading is what answers the
+		 * delayed Claim() invocation, so nothing here needs to wait.
+		 */
+		ssc_sensor_light_open (drv_data->sensor, NULL, light_open_done, NULL);
 	} else {
 		if (!drv_data->measurement_id)
 			return;
@@ -101,8 +130,7 @@ ssc_light_set_polling (SensorDevice *sensor_device, gboolean state)
 		g_clear_signal_handler (&drv_data->measurement_id, drv_data->sensor);
 
 		/* Disable sensor */
-		if (!ssc_sensor_light_close_sync (drv_data->sensor, NULL, &error))
-			g_warning ("Closing SSC light sensor failed: %s", error->message);
+		ssc_sensor_light_close (drv_data->sensor, NULL, light_close_done, NULL);
 	}
 }
 
