#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-only
"""Substitute for `bc -q kernel/time/timeconst.bc` used by Kbuild.

`bc` is not installed on this host and cannot be installed without root, so the
kernel's timeconst.h cannot be generated by the real interpreter.  This script
reimplements the arithmetic of kernel/time/timeconst.bc exactly (integer
division, scale=0) and only accepts the HZ values of interest.  Its output for
HZ=1000 is verified byte-for-byte against a bc-generated header that exists in
this checkout (.work/rear-camera/output/include/generated/timeconst.h); see
checks/run_compile_check.sh.

Usage (what Kbuild does): | echo HZ | bc -q kernel/time/timeconst.bc
"""

import sys


def gcd(a, b):
    while b:
        a, b = b, a % b
    return a


def fmul(shift, n, d):
    return (2**shift * n + d - 1) // d


def fadj(shift, n, d):
    d = d // gcd(n, d)
    return 2**shift * (d - 1) // d


def fmuls(bits, n, d):
    for s in range(64):
        if fmul(s, n, d) >= 2 ** (bits - 1):
            return s
    raise SystemExit("fmuls did not converge")


def timeconst(hz):
    out = []
    out.append("/* Automatically generated by kernel/time/timeconst.bc */")
    out.append(f"/* Time conversion constants for HZ == {hz} */")
    out.append("")
    out.append("#ifndef KERNEL_TIMECONST_H")
    out.append("#define KERNEL_TIMECONST_H")
    out.append("")
    out.append("#include <linux/param.h>")
    out.append("#include <linux/types.h>")
    out.append("")
    out.append(f"#if HZ != {hz}")
    out.append('#error "include/generated/timeconst.h has the wrong HZ value!"')
    out.append("#endif")
    out.append("")

    s = fmuls(32, 1000, hz)
    out.append(f"#define HZ_TO_MSEC_MUL32\tU64_C(0x{fmul(s, 1000, hz):X})")
    out.append(f"#define HZ_TO_MSEC_ADJ32\tU64_C(0x{fadj(s, 1000, hz):X})")
    out.append(f"#define HZ_TO_MSEC_SHR32\t{s}")

    s = fmuls(32, hz, 1000)
    out.append(f"#define MSEC_TO_HZ_MUL32\tU64_C(0x{fmul(s, hz, 1000):X})")
    out.append(f"#define MSEC_TO_HZ_ADJ32\tU64_C(0x{fadj(s, hz, 1000):X})")
    out.append(f"#define MSEC_TO_HZ_SHR32\t{s}")

    cd = gcd(hz, 1000)
    out.append(f"#define HZ_TO_MSEC_NUM\t\t{1000 // cd}")
    out.append(f"#define HZ_TO_MSEC_DEN\t\t{hz // cd}")
    out.append(f"#define MSEC_TO_HZ_NUM\t\t{hz // cd}")
    out.append(f"#define MSEC_TO_HZ_DEN\t\t{1000 // cd}")
    out.append("")

    s = fmuls(32, 1000000, hz)
    out.append(f"#define HZ_TO_USEC_MUL32\tU64_C(0x{fmul(s, 1000000, hz):X})")
    out.append(f"#define HZ_TO_USEC_ADJ32\tU64_C(0x{fadj(s, 1000000, hz):X})")
    out.append(f"#define HZ_TO_USEC_SHR32\t{s}")

    s = fmuls(32, hz, 1000000)
    out.append(f"#define USEC_TO_HZ_MUL32\tU64_C(0x{fmul(s, hz, 1000000):X})")
    out.append(f"#define USEC_TO_HZ_ADJ32\tU64_C(0x{fadj(s, hz, 1000000):X})")
    out.append(f"#define USEC_TO_HZ_SHR32\t{s}")

    cd = gcd(hz, 1000000)
    out.append(f"#define HZ_TO_USEC_NUM\t\t{1000000 // cd}")
    out.append(f"#define HZ_TO_USEC_DEN\t\t{hz // cd}")
    out.append(f"#define USEC_TO_HZ_NUM\t\t{hz // cd}")
    out.append(f"#define USEC_TO_HZ_DEN\t\t{1000000 // cd}")

    cd = gcd(hz, 1000000000)
    out.append(f"#define HZ_TO_NSEC_NUM\t\t{1000000000 // cd}")
    out.append(f"#define HZ_TO_NSEC_DEN\t\t{hz // cd}")
    out.append(f"#define NSEC_TO_HZ_NUM\t\t{hz // cd}")
    out.append(f"#define NSEC_TO_HZ_DEN\t\t{1000000000 // cd}")
    out.append("")
    out.append("#endif /* KERNEL_TIMECONST_H */")
    return "\n".join(out) + "\n"


def main(argv):
    # Kbuild: echo $(CONFIG_HZ) | bc -q kernel/time/timeconst.bc
    hz = int(sys.stdin.read().strip() or "0")
    if hz < 2:
        sys.stdout.write("#error Totally bogus HZ value!\n")
        return 1
    sys.stdout.write(timeconst(hz))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
