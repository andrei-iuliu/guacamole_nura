# A second snapshot after the desktop/session has settled.  OnBootSec is
# monotonic boot time; Persistent=false deliberately avoids wall-clock
# catch-up (the device clock is not trustworthy) and OnCalendar is not used.
#
# Installed and enabled by device-oneplus-guacamole.  The service also runs
# once at multi-user.target.
[Unit]
Description=Nura late boot diagnostics snapshot

[Timer]
OnBootSec=3min
AccuracySec=30s
Persistent=false
Unit=nura-boot-diagnostics.service

[Install]
WantedBy=timers.target
