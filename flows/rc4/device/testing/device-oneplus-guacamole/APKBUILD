# rc4 candidate: copy of the reviewed rc3 package, pkgrel+1 with only the
# opt-in modem-rail release helper/unit added (kernel patch 0044).
# pkgrel 17 (shared by the Plasma and Phosh images): pkgrel 16's Plasma Mobile
# corner-inset preset from device/testing (plasma-corners 945baff/a3141aa) and
# guacamole-boot-slot (timer + service, enabled by its own preset) that marks
# the booted A/B slot successful, plus the rc4i GPU crash collector
# (nura-gpu-crash-capture + its units/udev rule; the timer is enabled by
# 83-nura-gpu-crash.preset) that copies /sys/class/devcoredump data and a
# dmesg tail to /var/lib/nura/gpu-crash and releases the dump.
# The unit is installed but deliberately NOT enabled in 80-guacamole.preset
# and there is no guacamole-mpss-start hook: enabling it on the phone is the
# opt-in.  Everything else (including the preset) is unchanged.
# pkgrel 18 adds the guacamole-chgctrl CLI and persistent custom charge windows.
# pkgrel 19 adds the opt-in nura-gpu-mode toggle (normal rendering by default),
# the nura-gpu-soak fault-counter helper, the /etc/profile.d bridge that makes
# the toggle reach phoc and its children, and the systemd log-level drop-ins
# that keep the rc4j default at info (the ABL appends a bare "debug" token to
# the kernel cmdline; see 90-nura-loglevel.conf).
# pkgrel 20 adds nura-upgrade: a root-only, auditable apk upgrade wrapper that
# snapshots versions, refuses unsatisfiable pinned transactions, highlights
# sensitive packages and warns while a GPU soak is open.
# pkgrel 21 (rc4o) enables guacamole-mss-release.service through its own
# 82-guacamole-mss-release.preset, so the modem-rail vote is released at
# every boot; 80-guacamole.preset stays identical to rc3's.
# pkgrel 22 arms the qcom_wdt hardware watchdog from systemd (20 s at
# runtime, 30 s for reboots; see 91-nura-watchdog.conf), so a kernel
# freeze at shutdown reboots the phone instead of leaving a black screen.
# It also works around reboot hangs that need a lit panel during the
# kernel's final shutdown: 91-nura-fbdev-restore.conf stops the fbdev
# console from re-initialising the panel when KWin exits, and the
# nura-panel-off-on-exit user unit turns the panel off before KWin stops
# (Plasma only).
# Reference: <https://postmarketos.org/devicepkg>
# Co-Maintainer: Uclydde <julianbraha@gmail.com>
maintainer="Casey Connolly <kcxt@postmarketos.org>"
pkgname=device-oneplus-guacamole
pkgdesc="OnePlus 7 Pro"
pkgver=4
pkgrel=23
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !tracedeps"
depends="
	firmware-oneplus-guacamole
	linux-postmarketos-qcom-sm8150
	mesa-vulkan-freedreno
	mkbootimg
	python3
	alsa-ucm-conf
	bluez-btmgmt
	e2fsprogs-extra
	hexagonrpcd
	hexagonrpcd-systemd
	hexagonrpcd-udev
	iio-sensor-proxy
	postmarketos-base
	msm-modem
	nura-clock
	rmtfs
	tqftpserv
"
makedepends="devicepkg-dev"
# Public sensor DSP support files from the LineageOS 24.0 20261102 OTA
# (vendor_b sensor config, dsp_b SLPI libraries). The per-unit persist
# registry is deliberately not packaged; guacamole-sensors-registry imports
# this device's own calibration at first boot and fails closed without it.
# Generate the tarball with:
#   scripts/prepare_sensor_bundle.py
_sensors="guacamole-sensors-20261102"
subpackages="$pkgname-openrc"
source="
	deviceinfo
	$pkgname-openrc.post-install
	guacamole-mpss.initd
	guacamole-mpss-start
	guacamole-mpss.service
	guacamole-mss-release
	guacamole-mss-release.service
	guacamole-chgctrl.initd
	guacamole-chgctrl.daemon
	guacamole-chgctrl.confd
	guacamole-chgctrl.service
	80-guacamole.preset
	sxmo_deviceprofile-oneplus-guacamole.sh
	90-wifi-wowlan.conf
	90-ath10k-wowlan.rules
	10-wifi-wowlan
	HiFi.conf
	guacamole.conf
	guacamole-bdaddr
	guacamole-bdaddr.service
	90-guacamole-bdaddr.rules
	guacamole-wlanmac
	90-guacamole-wlanmac.rules
	90-guacamole-sensors.rules
	61-guacamole-accel-mount-matrix.rules
	72-guacamole-haptics.rules
	nura-boot-diagnostics
	nura-boot-diagnostics.service
	nura-boot-diagnostics.timer
	81-nura-boot-diagnostics.preset
	guacamole-sensors-registry
	guacamole-sensors-registry.service
	hexagonrpcd-sdsp-registry.conf
	iio-sensor-proxy-guacamole.conf
	plasma-mobile-preset-oneplus-guacamole.conf
	guacamole-boot-slot
	guacamole-boot-slot.service
	guacamole-boot-slot.timer
	82-guacamole-boot-slot.preset
	nura-gpu-crash-capture
	nura-gpu-crash-capture.service
	nura-gpu-crash-capture.timer
	82-guacamole-mss-release.preset
	83-nura-gpu-crash.preset
	90-nura-gpu-crash.rules
	nura-gpu-mode
	nura-gpu-soak
	nura-upgrade
	nura-gpu.sh
	90-nura-loglevel.conf
	91-nura-watchdog.conf
	91-nura-fbdev-restore.conf
	nura-panel-off-on-exit.service
	$_sensors.tar.gz
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Enable WoWLAN (magic + disconnect) by default (NM connection default).
	install -Dm644 "$srcdir/90-wifi-wowlan.conf" \
		"$pkgdir/usr/lib/NetworkManager/conf.d/90-wifi-wowlan.conf"

	# Force the Wi-Fi device wakeup-capable bit on so WoWLAN can wake from s2idle.
	install -Dm644 "$srcdir/90-ath10k-wowlan.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-ath10k-wowlan.rules"

	# Deterministically arm wake-on-wlan on the active Wi-Fi profile.
	install -Dm755 "$srcdir/10-wifi-wowlan" \
		"$pkgdir/etc/NetworkManager/dispatcher.d/10-wifi-wowlan"

	# ALSA UCM: TFA9874 speakers on QUAT_MI2S_RX, handset mic on SLIMBUS_0_TX.
	install -Dm644 "$srcdir/HiFi.conf" \
		"$pkgdir/usr/share/alsa/ucm2/OnePlus/guacamole/HiFi.conf"
	install -Dm644 "$srcdir/guacamole.conf" \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8150/OnePlus 7 Pro.conf"

	# Bluetooth: stable public address derived from the factory Wi-Fi MAC.
	install -Dm755 "$srcdir/guacamole-bdaddr" "$pkgdir/usr/libexec/guacamole-bdaddr"
	install -Dm644 "$srcdir/guacamole-bdaddr.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-bdaddr.service"
	install -Dm644 "$srcdir/90-guacamole-bdaddr.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-guacamole-bdaddr.rules"

	# Wi-Fi: factory MAC as the interface address (NetworkManager still
	# applies its per-network stable MAC while connected).
	install -Dm755 "$srcdir/guacamole-wlanmac" "$pkgdir/usr/libexec/guacamole-wlanmac"
	install -Dm644 "$srcdir/90-guacamole-wlanmac.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-guacamole-wlanmac.rules"

	# Charge policy (USB PD contract, DCP, thermal throttling, charge window)
	install -Dm755 "$srcdir/guacamole-chgctrl.daemon" "$pkgdir/usr/libexec/guacamole-chgctrl"
	install -d "$pkgdir/usr/bin"
	ln -s ../libexec/guacamole-chgctrl "$pkgdir/usr/bin/guacamole-chgctrl"
	install -Dm644 "$srcdir/guacamole-chgctrl.confd" "$pkgdir/etc/conf.d/guacamole-chgctrl"
	install -Dm644 "$srcdir/guacamole-chgctrl.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-chgctrl.service"
	install -Dm644 "$srcdir/80-guacamole.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/80-guacamole.preset"

	# Modem: the SM8150 MPSS PAS descriptor has auto_boot=false. The OpenRC
	# unit and the opt-in systemd unit share this resolver/bounded-wait helper;
	# the systemd unit is deliberately not in the preset (see its header).
	install -Dm755 "$srcdir/guacamole-mpss-start" \
		"$pkgdir/usr/libexec/guacamole-mpss-start"
	install -Dm644 "$srcdir/guacamole-mpss.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-mpss.service"

	# Modem rail release (kernel 0044).  Installed but NOT enabled by the
	# preset; systemctl enable --now guacamole-mss-release.service is the
	# opt-in after the proxy handover has been observed on the phone.
	install -Dm755 "$srcdir/guacamole-mss-release" \
		"$pkgdir/usr/libexec/guacamole-mss-release"
	install -Dm644 "$srcdir/guacamole-mss-release.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-mss-release.service"

	# Sensors: the SLPI sensor DSP is served its configuration, registry and
	# libraries by hexagonrpcd from /usr/share/qcom. The registry is per unit
	# and rewritten by the DSP, so it lives under /var/lib and is imported
	# from persist on first boot by guacamole-sensors-registry.
	local q="$pkgdir/usr/share/qcom" sd="$srcdir/$_sensors"
	mkdir -p "$q/sensors" "$q/socinfo" "$q/dsp"
	cp -r "$sd/sensors/config" "$q/sensors/config"
	install -m644 "$sd/sensors/sns_reg.conf" "$q/sensors/sns_reg.conf"
	# hexagonrpcd's default root is /usr/share/qcom; it maps <root>/dsp/<dsp>
	# to the DSP's /usr/lib/qcom/adsp. Keep the old <root>/sdsp path as a
	# compatibility symlink only.
	cp -r "$sd/sdsp" "$q/dsp/sdsp"
	ln -s dsp/sdsp "$q/sdsp"
	printf MTP > "$q/socinfo/hw_platform"
	printf 339 > "$q/socinfo/soc_id"
	printf Unknown > "$q/socinfo/platform_subtype"
	printf 0 > "$q/socinfo/platform_subtype_id"
	printf 65536 > "$q/socinfo/platform_version"
	printf 2.2 > "$q/socinfo/revision"
	ln -s /var/lib/guacamole/sensors/registry "$q/sensors/registry"
	ln -s /var/lib/guacamole/sensors/project_info "$q/project_info"
	local f
	for f in sns_reg_version file1 file2; do
		ln -s "/var/lib/guacamole/sensors/$f" "$q/sensors/$f"
	done
	find "$q" -type f -exec chmod 644 {} +
	install -Dm755 "$srcdir/guacamole-sensors-registry" \
		"$pkgdir/usr/libexec/guacamole-sensors-registry"
	install -Dm644 "$srcdir/guacamole-sensors-registry.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-sensors-registry.service"
	install -Dm644 "$srcdir/hexagonrpcd-sdsp-registry.conf" \
		"$pkgdir/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/guacamole-registry.conf"
	install -Dm644 "$srcdir/90-guacamole-sensors.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-guacamole-sensors.rules"
	install -Dm644 "$srcdir/61-guacamole-accel-mount-matrix.rules" \
		"$pkgdir/usr/lib/udev/rules.d/61-guacamole-accel-mount-matrix.rules"

	# Haptics: feedbackd only uses input devices tagged FEEDBACKD_TYPE=vibra,
	# and stock 72-feedbackd.rules does not know the AW8697 input name.  This
	# rule must sort before 73-seat-late.rules so TAG+="uaccess" reaches the
	# Plasma user's session.  The alert-slider line is a name-based fallback
	# for feedbackd's fbd-alert-slider handler.
	install -Dm644 "$srcdir/72-guacamole-haptics.rules" \
		"$pkgdir/usr/lib/udev/rules.d/72-guacamole-haptics.rules"

	# Bounded boot-state snapshots in the persistent journal.  The helper is
	# a byte-identical source copy of scripts/collect_boot_diagnostics.sh;
	# keep the two in sync (tests/test_rc3_device_sources.py asserts it).
	install -Dm755 "$srcdir/nura-boot-diagnostics" \
		"$pkgdir/usr/bin/nura-boot-diagnostics"
	install -Dm644 "$srcdir/nura-boot-diagnostics.service" \
		"$pkgdir/usr/lib/systemd/system/nura-boot-diagnostics.service"
	install -Dm644 "$srcdir/nura-boot-diagnostics.timer" \
		"$pkgdir/usr/lib/systemd/system/nura-boot-diagnostics.timer"
	install -Dm644 "$srcdir/81-nura-boot-diagnostics.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/81-nura-boot-diagnostics.preset"

	install -Dm644 "$srcdir/iio-sensor-proxy-guacamole.conf" \
		"$pkgdir/usr/lib/systemd/system/iio-sensor-proxy.service.d/guacamole.conf"

	# Plasma Mobile: keep the status bar and navigation panel out of the
	# rounded display corners. plasma-mobile-envmanager looks the preset up
	# by the DT root compatible strings. The mainline DTB says
	# "oneplus,guacamole"; the ABL wrapper DTB currently booted says
	# "qcom,sm8150-mtp". That generic name is acceptable here because this
	# package only installs on guacamole. abuild rejects commas in source=
	# names, so the file is renamed on install.  (Phosh reads the same
	# geometry from gmobile's built-in display-panel data instead; see
	# flows/rc4/device/testing/gmobile.)
	local preset
	for preset in oneplus,guacamole qcom,sm8150-mtp; do
		install -Dm644 "$srcdir/plasma-mobile-preset-oneplus-guacamole.conf" \
			"$pkgdir/usr/share/plasma-mobile-device-presets/$preset.conf"
	done

	# A/B slot: mark the booted slot successful once the UI has been up for
	# two minutes, so ABL's retry counter cannot run down (Linux has no
	# boot-control HAL).  Shared by the Plasma and Phosh images.
	install -Dm755 "$srcdir/guacamole-boot-slot" \
		"$pkgdir/usr/libexec/guacamole-boot-slot"
	install -Dm644 "$srcdir/guacamole-boot-slot.service" \
		"$pkgdir/usr/lib/systemd/system/guacamole-boot-slot.service"
	install -Dm644 "$srcdir/guacamole-boot-slot.timer" \
		"$pkgdir/usr/lib/systemd/system/guacamole-boot-slot.timer"
	install -Dm644 "$srcdir/82-guacamole-boot-slot.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/82-guacamole-boot-slot.preset"

	# GPU crash capture: when drm/msm publishes a devcoredump in
	# /sys/class/devcoredump, copy it (and a dmesg tail) under
	# /var/lib/nura/gpu-crash and release it, so the next hang is not
	# discarded.  90-nura-gpu-crash.rules starts the oneshot on the uevent;
	# the timer is the backstop and is what the preset enables.  The script
	# never writes to debugfs and needs no extra package (dmesg/timeout are
	# guarded).
	install -Dm755 "$srcdir/nura-gpu-crash-capture" \
		"$pkgdir/usr/libexec/nura-gpu-crash-capture"
	install -Dm644 "$srcdir/nura-gpu-crash-capture.service" \
		"$pkgdir/usr/lib/systemd/system/nura-gpu-crash-capture.service"
	install -Dm644 "$srcdir/nura-gpu-crash-capture.timer" \
		"$pkgdir/usr/lib/systemd/system/nura-gpu-crash-capture.timer"
	install -Dm644 "$srcdir/82-guacamole-mss-release.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/82-guacamole-mss-release.preset"
	install -Dm644 "$srcdir/83-nura-gpu-crash.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/83-nura-gpu-crash.preset"
	install -Dm644 "$srcdir/90-nura-gpu-crash.rules" \
		"$pkgdir/usr/lib/udev/rules.d/90-nura-gpu-crash.rules"

	# GPU: opt-in Mesa debug override and the fault-counter soak helper.
	# nura-gpu-mode writes /var/lib/nura/gpu-mode and the user-manager
	# /etc/environment.d drop-in; /etc/profile.d/nura-gpu.sh carries the same
	# value into phoc and every application started from the session.  The
	# package default is normal rendering (no state file).
	install -Dm755 "$srcdir/nura-gpu-mode" "$pkgdir/usr/bin/nura-gpu-mode"
	install -Dm755 "$srcdir/nura-gpu-soak" "$pkgdir/usr/bin/nura-gpu-soak"
	install -Dm755 "$srcdir/nura-upgrade" "$pkgdir/usr/bin/nura-upgrade"
	install -Dm644 "$srcdir/nura-gpu.sh" "$pkgdir/etc/profile.d/nura-gpu.sh"
	install -d "$pkgdir/etc/environment.d"
	# 0755 so `nura-gpu-mode status` works without root; the collector's
	# StateDirectory=nura/gpu-crash keeps its own 0700 subdirectory.
	install -d -m 755 "$pkgdir/var/lib/nura"

	# rc4j: systemd and journald default to info instead of the bootloader's
	# "debug" token.  Same file in both manager config directories; see the
	# file header for the exact parse order.
	install -Dm644 "$srcdir/90-nura-loglevel.conf" \
		"$pkgdir/etc/systemd/system.conf.d/90-nura-loglevel.conf"
	install -Dm644 "$srcdir/90-nura-loglevel.conf" \
		"$pkgdir/etc/systemd/user.conf.d/90-nura-loglevel.conf"

	# Hardware watchdog for PID 1 (system manager only).
	install -Dm644 "$srcdir/91-nura-watchdog.conf" \
		"$pkgdir/etc/systemd/system.conf.d/91-nura-watchdog.conf"

	# Reboot hang workaround: no fbdev restore when KWin exits, and the
	# panel turned off before KWin stops (enabled for every user).
	install -Dm644 "$srcdir/91-nura-fbdev-restore.conf" \
		"$pkgdir/usr/lib/tmpfiles.d/91-nura-fbdev-restore.conf"
	install -Dm644 "$srcdir/nura-panel-off-on-exit.service" \
		"$pkgdir/usr/lib/systemd/user/nura-panel-off-on-exit.service"
	install -d "$pkgdir/usr/lib/systemd/user/plasma-workspace.target.wants"
	ln -s ../nura-panel-off-on-exit.service \
		"$pkgdir/usr/lib/systemd/user/plasma-workspace.target.wants/nura-panel-off-on-exit.service"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	depends="tqftpserv-openrc openrc"
	install -Dm755 "$srcdir/guacamole-mpss.initd" \
		"$subpkgdir/etc/init.d/guacamole-mpss"
	install -Dm755 "$srcdir/guacamole-chgctrl.initd" \
		"$subpkgdir/etc/init.d/guacamole-chgctrl"
	# sxmo looks up device profiles by the exact "vendor,codename" compatible
	# string; abuild rejects commas in source= filenames, so the tracked file
	# uses dashes and gets installed under the comma name sxmo expects.
	install -Dm755 "$srcdir/sxmo_deviceprofile-oneplus-guacamole.sh" \
		"$subpkgdir/usr/bin/sxmo_deviceprofile_oneplus,guacamole.sh"
}



