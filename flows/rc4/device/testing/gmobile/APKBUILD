1abee1dd7237747bfa548e72f50a17db7b4ed12f29ddb62fe08f24a28290127f3cd3233e69f2e9d4c85dafd8d0974de71e3546f03138e548dcd756a4eed1af3d  0001-data-add-OnePlus-7-Pro-guacamole-display-panel.patch
"
