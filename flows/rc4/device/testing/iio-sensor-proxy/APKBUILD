# Nura rc4j: Alpine community/iio-sensor-proxy 3.9-r2 (the version in the
# pinned edge index) plus one patch.  The patch stops the four SSC drivers
# from calling libssc's synchronous enable/disable helpers from inside the
# D-Bus Claim*()/Release*() method handlers.
#
# Those helpers (libssc 0.4.4) iterate the *shared default* GMainContext in a
# loop that does not block, so a Claim*() that arrives while another claim is
# being served is dispatched re-entrantly inside the first claim's wait, and
# the wait itself burns a whole core.  A client that claims several sensors at
# once -- Phosh Mobile Settings' Sensors page does exactly that -- wedges the
# daemon in that loop.  See flows/rc4/topics/sensors/README.md for the
# backtrace, the disassembly of the shipped libssc helper and the analysis.
#
# 3.9-r101 adds 0002: the daemon owns its bus name before it opens the
# sensors, and the SSC open waits on the main loop, so a Claim*() sent right
# away (KWin does this under Plasma) was registered without starting the
# sensor; auto-rotation never got a reading.  0002 starts sensors that were
# claimed during startup, like the hotplug path does.
#
# pkgrel 100+ keeps this local build above the repository's r2.  The rc4 rootfs
# is systemd-only, so the openrc subpackage and iio-sensor-proxy.initd are
# dropped here; -systemd (the unit) and -udev (the FastRPC rules) are the
# subpackages the images install.
#
# Upstream recipe (3.9-r2):
# https://gitlab.alpinelinux.org/alpine/aports/-/blob/master/community/iio-sensor-proxy/APKBUILD
# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=iio-sensor-proxy
pkgver=3.9
pkgrel=101
pkgdesc="IIO sensors to D-Bus proxy"
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy"
arch="all"
license="GPL-2.0-or-later"
depends="dbus"
makedepends="
	eudev-dev
	glib-dev
	libgudev-dev
	meson
	polkit-dev
	libssc-dev
	"
subpackages="$pkgname-systemd $pkgname-udev $pkgname-dbg"
source="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/-/archive/$pkgver/iio-sensor-proxy-$pkgver.tar.gz
	0001-drv-ssc-enable-and-disable-sensors-asynchronously.patch
	0002-main-start-sensors-claimed-during-startup.patch
	"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dssc-support=enabled \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

