From: Nura local rear-camera port
Subject: [PATCH] media guacamole rear sensors and lenses

Rebased on v7.0.0-sm8150 (8e126dbc), from Cube-Oakley/omarchy-mobile
f702f688288e59e3566f113d411ac7d18e4d0201. Original CAMSS patches
by Sr-0w; sensor and lens sources retain their authors and licenses.
See docs/REAR_CAMERA_7_0_BRINGUP.md for adaptations and limitations.

Nura-Category: upstream-feature
Nura-Origin: Cube-Oakley/omarchy-mobile f702f688 (sensors by Sr-0w)
Upstream-Status: not in mainline v7.2 (IMX586/IMX481/LC898217XC absent)

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -275,6 +275,18 @@
 
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx412.
+
+config VIDEO_IMX481
+	tristate "Sony IMX481 sensor support"
+	depends on OF_GPIO
+	help
+	  Sony IMX481 rear ultrawide sensor. Module: imx481.
+
+config VIDEO_IMX586
+	tristate "Sony IMX586 sensor support"
+	depends on OF_GPIO
+	help
+	  Sony IMX586 rear main sensor. Module: imx586.
 
 config VIDEO_IMX415
 	tristate "Sony IMX415 sensor support"
@@ -858,6 +870,11 @@
 	  This is a driver for the AD5820 camera lens voice coil.
 	  It is used for example in Nokia N900 (RX-51).
 
+config VIDEO_LC898217XC
+	tristate "ON Semiconductor LC898217XC lens support"
+	help
+	  Rear camera voice coil actuator. Module: lc898217xc.
+
 config VIDEO_AK7375
 	tristate "AK7375 lens voice coil support"
 	help
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -169,3 +169,7 @@
 obj-$(CONFIG_VIDEO_VPX3220) += vpx3220.o
 obj-$(CONFIG_VIDEO_WM8739) += wm8739.o
 obj-$(CONFIG_VIDEO_WM8775) += wm8775.o
+
+obj-$(CONFIG_VIDEO_IMX481) += imx481.o
+obj-$(CONFIG_VIDEO_IMX586) += imx586.o
+obj-$(CONFIG_VIDEO_LC898217XC) += lc898217xc.o
