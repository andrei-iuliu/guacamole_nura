+ * Copyright (C) 2021 Intel Corporation
+ * Copyright (C) 2026 OnePlus 7T Pro Linux contributors
+ *
+ * The OnePlus 7T Pro bring-up's driver (hotdog r181: 0100, 0101), with one
+ * addition for guacamole (docs/camera-ultrawide-20260924.md): the sensor links
+ * its AK7374 focus actuator (lens-focus), as our IMX586 driver does, so the
+ * lens powers with it.
+ */
+#include <linux/unaligned.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+/* Streaming Mode */
+#define IMX481_REG_MODE_SELECT	0x0100
+#define IMX481_MODE_STANDBY	0x00
+#define IMX481_MODE_STREAMING	0x01
+
+/* Lines per frame */
+#define IMX481_REG_LPFR		0x0340
+
+/* Chip ID */
+#define IMX481_REG_ID		0x0016
+#define IMX481_ID		0x0481
+
+/* Exposure control */
+#define IMX481_REG_EXPOSURE_CIT	0x0202
+#define IMX481_EXPOSURE_MIN	1
+#define IMX481_EXPOSURE_OFFSET	18
+#define IMX481_EXPOSURE_STEP	1
+#define IMX481_EXPOSURE_DEFAULT	0x0dcc
+
+/* Analog gain control */
+#define IMX481_REG_AGAIN	0x0204
+#define IMX481_AGAIN_MIN	0
+#define IMX481_AGAIN_MAX	960
+#define IMX481_AGAIN_STEP	1
+#define IMX481_AGAIN_DEFAULT	0
+
+/* Group hold register */
+#define IMX481_REG_HOLD		0x0104
+
+/* Input clock rate */
+#define IMX481_INCLK_RATE	19200000
+
+#define IMX481_VANA_MIN_UV	3300000
+#define IMX481_VANA_MAX_UV	3320000
+#define IMX481_VDIG_LOAD_UA	1100000
+
+/* CSI2 HW configuration */
+#define IMX481_LINK_FREQ	654075000
+#define IMX481_NUM_DATA_LANES	4
+
+#define IMX481_REG_MIN		0x00
+#define IMX481_REG_MAX		0xffff
+
+/**
+ * struct imx481_reg - imx481 sensor register
+ * @address: Register address
+ * @val: Register value
+ */
+struct imx481_reg {
+	u16 address;
+	u8 val;
+};
+
+/**
+ * struct imx481_reg_list - imx481 sensor register list
+ * @num_of_regs: Number of registers in the list
+ * @regs: Pointer to register list
+ */
+struct imx481_reg_list {
+	u32 num_of_regs;
+	const struct imx481_reg *regs;
+};
+
+/**
+ * struct imx481_mode - imx481 sensor mode structure
+ * @width: Frame width
+ * @height: Frame height
+ * @code: Format code
+ * @hblank: Horizontal blanking in lines
+ * @vblank: Vertical blanking in lines
+ * @vblank_min: Minimum vertical blanking in lines
+ * @vblank_max: Maximum vertical blanking in lines
+ * @pclk: Sensor pixel clock
+ * @link_freq_idx: Link frequency index
+ * @reg_list: Register list for sensor mode
+ */
+struct imx481_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 hblank;
+	u32 vblank;
+	u32 vblank_min;
+	u32 vblank_max;
+	u64 pclk;
+	u32 link_freq_idx;
+	struct imx481_reg_list reg_list;
+};
+
+/**
+ * struct imx481 - imx481 sensor device structure
+ * @dev: Pointer to generic device
+ * @client: Pointer to i2c client
+ * @sd: V4L2 sub-device
+ * @pad: Media pad. Only one pad supported
+ * @reset_gpio: Sensor reset gpio
+ * @vana_enable_gpio: Board analogue-rail gate gpio
+ * @inclk: Sensor input clock
+ * @vana: Analogue regulator
+ * @vdig: Digital regulator
+ * @vio: I/O regulator
+ * @ctrl_handler: V4L2 control handler
+ * @link_freq_ctrl: Pointer to link frequency control
+ * @pclk_ctrl: Pointer to pixel clock control
+ * @hblank_ctrl: Pointer to horizontal blanking control
+ * @vblank_ctrl: Pointer to vertical blanking control
+ * @exp_ctrl: Pointer to exposure control
+ * @again_ctrl: Pointer to analog gain control
+ * @vblank: Vertical blanking in lines
+ * @cur_mode: Pointer to current selected sensor mode
+ * @mutex: Mutex for serializing sensor controls
+ */
+struct imx481 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vana_enable_gpio;
+	struct device_link *lens_link;
+	struct clk *inclk;
+	struct regulator *vana;
+	struct regulator *vdig;
+	struct regulator *vio;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq_ctrl;
+	struct v4l2_ctrl *pclk_ctrl;
+	struct v4l2_ctrl *hblank_ctrl;
+	struct v4l2_ctrl *vblank_ctrl;
+	struct {
+		struct v4l2_ctrl *exp_ctrl;
+		struct v4l2_ctrl *again_ctrl;
+	};
+	u32 vblank;
+	const struct imx481_mode *cur_mode;
+	/* Serializes controls and streaming state. */
+	struct mutex mutex;
+};
+
+static const s64 link_freq[] = {
+	IMX481_LINK_FREQ,
+};
