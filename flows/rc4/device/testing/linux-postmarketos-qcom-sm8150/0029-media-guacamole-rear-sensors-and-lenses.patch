+/**
+ * imx481_start_streaming() - Start sensor stream
+ * @imx481: pointer to imx481 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_start_streaming(struct imx481 *imx481)
+{
+	const struct imx481_reg_list *reg_list;
+	int ret;
+
+	ret = imx481_write_regs(imx481, imx481_init_regs,
+				ARRAY_SIZE(imx481_init_regs));
+	if (ret) {
+		dev_err(imx481->dev, "failed to write global registers\n");
+		return ret;
+	}
+
+	/* Write sensor mode registers */
+	reg_list = &imx481->cur_mode->reg_list;
+	ret = imx481_write_regs(imx481, reg_list->regs,
+				reg_list->num_of_regs);
+	if (ret) {
+		dev_err(imx481->dev, "failed to write mode registers\n");
+		return ret;
+	}
+
+	/* Setup handler will write actual exposure and gain */
+	ret =  __v4l2_ctrl_handler_setup(imx481->sd.ctrl_handler);
+	if (ret) {
+		dev_err(imx481->dev, "fail to setup handler\n");
+		return ret;
+	}
+
+	/* Start streaming */
+	ret = imx481_write_reg(imx481, IMX481_REG_MODE_SELECT,
+			       1, IMX481_MODE_STREAMING);
+	if (ret) {
+		dev_err(imx481->dev, "failed to start streaming\n");
+		return ret;
+	}
+
+	dev_info(imx481->dev, "streaming 4656x3496 RAW10 over four-lane D-PHY\n");
+
+	return 0;
+}
+
+/**
+ * imx481_stop_streaming() - Stop sensor stream
+ * @imx481: pointer to imx481 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_stop_streaming(struct imx481 *imx481)
+{
+	return imx481_write_reg(imx481, IMX481_REG_MODE_SELECT,
+				1, IMX481_MODE_STANDBY);
+}
+
+/**
+ * imx481_set_stream() - Enable sensor streaming
+ * @sd: pointer to imx481 subdevice
+ * @enable: set to enable sensor streaming
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx481 *imx481 = to_imx481(sd);
+	int ret;
+
+	mutex_lock(&imx481->mutex);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(imx481->dev);
+		if (ret)
+			goto error_unlock;
+
+		ret = imx481_start_streaming(imx481);
+		if (ret)
+			goto error_power_off;
+	} else {
+		imx481_stop_streaming(imx481);
+		pm_runtime_put(imx481->dev);
+	}
+
+	mutex_unlock(&imx481->mutex);
+
+	return 0;
+
+error_power_off:
+	pm_runtime_put(imx481->dev);
+error_unlock:
+	mutex_unlock(&imx481->mutex);
+
+	return ret;
+}
+
+/**
+ * imx481_detect() - Detect imx481 sensor
+ * @imx481: pointer to imx481 device
+ *
+ * Return: 0 if successful, -EIO if sensor id does not match
+ */
+static int imx481_detect(struct imx481 *imx481)
+{
+	int ret;
+	u32 val;
+
+	ret = imx481_read_reg(imx481, IMX481_REG_ID, 2, &val);
+	if (ret)
+		return ret;
+
+	if (val != IMX481_ID) {
+		dev_err(imx481->dev, "chip id mismatch: %x!=%x\n",
+			IMX481_ID, val);
+		return -ENXIO;
+	}
+
+	return 0;
+}
+
+/**
+ * imx481_parse_hw_config() - Parse HW configuration and check if supported
+ * @imx481: pointer to imx481 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_parse_hw_config(struct imx481 *imx481)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(imx481->dev);
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY
+	};
+	struct fwnode_handle *ep;
+	unsigned long rate;
+	unsigned int i;
+	int ret;
+
+	if (!fwnode)
+		return -ENXIO;
+
+	/* The GPIO values are logical; reset is active low in the DT. */
+	imx481->reset_gpio = devm_gpiod_get(imx481->dev, "reset",
+					    GPIOD_OUT_HIGH);
+	if (IS_ERR(imx481->reset_gpio)) {
+		dev_err(imx481->dev, "failed to get reset gpio %ld\n",
+			PTR_ERR(imx481->reset_gpio));
+		return PTR_ERR(imx481->reset_gpio);
+	}
+
+	imx481->vana_enable_gpio = devm_gpiod_get(imx481->dev, "vana-enable",
+						  GPIOD_OUT_LOW);
+	if (IS_ERR(imx481->vana_enable_gpio))
+		return dev_err_probe(imx481->dev,
+				     PTR_ERR(imx481->vana_enable_gpio),
+				     "failed to get VANA enable GPIO\n");
+
+	/* Get sensor input clock */
+	imx481->inclk = devm_clk_get(imx481->dev, NULL);
+	if (IS_ERR(imx481->inclk)) {
+		dev_err(imx481->dev, "could not get inclk\n");
+		return PTR_ERR(imx481->inclk);
+	}
+
+	ret = clk_set_rate(imx481->inclk, IMX481_INCLK_RATE);
+	if (ret)
+		return dev_err_probe(imx481->dev, ret,
+				     "could not set 19.2 MHz input clock\n");
+
+	rate = clk_get_rate(imx481->inclk);
+	if (rate != IMX481_INCLK_RATE) {
+		dev_err(imx481->dev, "inclk frequency mismatch\n");
+		return -EINVAL;
+	}
+
+	imx481->vana = devm_regulator_get(imx481->dev, "vana");
+	if (IS_ERR(imx481->vana))
+		return dev_err_probe(imx481->dev, PTR_ERR(imx481->vana),
+				     "failed to get VANA\n");
+
+	imx481->vdig = devm_regulator_get(imx481->dev, "vdig");
+	if (IS_ERR(imx481->vdig))
+		return dev_err_probe(imx481->dev, PTR_ERR(imx481->vdig),
+				     "failed to get VDIG\n");
+
+	imx481->vio = devm_regulator_get(imx481->dev, "vio");
+	if (IS_ERR(imx481->vio))
+		return dev_err_probe(imx481->dev, PTR_ERR(imx481->vio),
+				     "failed to get VIO\n");
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -ENXIO;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus_type != V4L2_MBUS_CSI2_DPHY) {
+		dev_err(imx481->dev, "endpoint must use D-PHY\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != IMX481_NUM_DATA_LANES) {
+		dev_err(imx481->dev,
+			"number of CSI2 data lanes %d is not supported\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	if (!bus_cfg.nr_of_link_frequencies) {
+		dev_err(imx481->dev, "no link frequencies defined\n");
+		ret = -EINVAL;
+		goto done_endpoint_free;
+	}
+
+	for (i = 0; i < bus_cfg.nr_of_link_frequencies; i++)
+		if (bus_cfg.link_frequencies[i] == IMX481_LINK_FREQ)
+			goto done_endpoint_free;
+
+	ret = -EINVAL;
+
+done_endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/* V4l2 subdevice ops */
+static const struct v4l2_subdev_video_ops imx481_video_ops = {
+	.s_stream = imx481_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops imx481_pad_ops = {
+	.enum_mbus_code = imx481_enum_mbus_code,
+	.enum_frame_size = imx481_enum_frame_size,
+	.get_fmt = imx481_get_pad_format,
+	.set_fmt = imx481_set_pad_format,
+	.get_selection = imx481_get_selection,
+};
+
+static const struct v4l2_subdev_ops imx481_subdev_ops = {
+	.video = &imx481_video_ops,
+	.pad = &imx481_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx481_internal_ops = {
+	.init_state = imx481_init_state,
+};
+
+/**
+ * imx481_power_on() - Sensor power on sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx481 *imx481 = to_imx481(sd);
+	int ret;
+
+	ret = regulator_set_voltage(imx481->vana, IMX481_VANA_MIN_UV,
+				    IMX481_VANA_MAX_UV);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set VANA voltage\n");
+
+	ret = regulator_enable(imx481->vana);
+	if (ret)
+		goto error_vana_voltage;
+
+	gpiod_set_value_cansleep(imx481->vana_enable_gpio, 1);
+	usleep_range(1000, 2000);
+
+	ret = regulator_set_load(imx481->vdig, IMX481_VDIG_LOAD_UA);
+	if (ret)
+		goto error_vana;
+
+	ret = regulator_enable(imx481->vdig);
+	if (ret)
+		goto error_vdig_load;
+	usleep_range(1000, 2000);
+
+	ret = regulator_enable(imx481->vio);
+	if (ret)
+		goto error_vdig;
+	usleep_range(1000, 2000);
+
+	ret = clk_prepare_enable(imx481->inclk);
+	if (ret) {
+		dev_err(imx481->dev, "failed to enable input clock\n");
+		goto error_vio;
+	}
+
+	usleep_range(1000, 1200);
+	gpiod_set_value_cansleep(imx481->reset_gpio, 0);
+	usleep_range(1000, 2000);
+
+	return 0;
+
+error_vio:
+	regulator_disable(imx481->vio);
+error_vdig:
+	regulator_disable(imx481->vdig);
+error_vdig_load:
+	regulator_set_load(imx481->vdig, 0);
+error_vana:
+	gpiod_set_value_cansleep(imx481->vana_enable_gpio, 0);
+	regulator_disable(imx481->vana);
+error_vana_voltage:
+	regulator_set_voltage(imx481->vana, 0, IMX481_VANA_MAX_UV);
+
+	return ret;
+}
+
+/**
+ * imx481_power_off() - Sensor power off sequence
+ * @dev: pointer to i2c device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx481 *imx481 = to_imx481(sd);
+
+	gpiod_set_value_cansleep(imx481->reset_gpio, 1);
+	clk_disable_unprepare(imx481->inclk);
+	regulator_disable(imx481->vio);
+	regulator_disable(imx481->vdig);
+	regulator_set_load(imx481->vdig, 0);
+	gpiod_set_value_cansleep(imx481->vana_enable_gpio, 0);
+	regulator_disable(imx481->vana);
+	regulator_set_voltage(imx481->vana, 0, IMX481_VANA_MAX_UV);
+
+	return 0;
+}
+
+/**
+ * imx481_init_controls() - Initialize sensor subdevice controls
+ * @imx481: pointer to imx481 device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static int imx481_init_controls(struct imx481 *imx481)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &imx481->ctrl_handler;
+	const struct imx481_mode *mode = imx481->cur_mode;
+	struct v4l2_fwnode_device_properties props;
+	u32 lpfr;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 8);
+	if (ret)
+		return ret;
+
+	/* Serialize controls with sensor device */
+	ctrl_hdlr->lock = &imx481->mutex;
+
+	/* Initialize exposure and gain */
+	lpfr = mode->vblank + mode->height;
+	imx481->exp_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					     &imx481_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     IMX481_EXPOSURE_MIN,
+					     lpfr - IMX481_EXPOSURE_OFFSET,
+					     IMX481_EXPOSURE_STEP,
+					     IMX481_EXPOSURE_DEFAULT);
+
+	imx481->again_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					       &imx481_ctrl_ops,
+					       V4L2_CID_ANALOGUE_GAIN,
+					       IMX481_AGAIN_MIN,
+					       IMX481_AGAIN_MAX,
+					       IMX481_AGAIN_STEP,
+					       IMX481_AGAIN_DEFAULT);
+
+	v4l2_ctrl_cluster(2, &imx481->exp_ctrl);
+
+	imx481->vblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx481_ctrl_ops,
+						V4L2_CID_VBLANK,
+						mode->vblank_min,
+						mode->vblank_max,
+						1, mode->vblank);
+
+	/* Read only controls */
+	imx481->pclk_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+					      &imx481_ctrl_ops,
+					      V4L2_CID_PIXEL_RATE,
+					      mode->pclk, mode->pclk,
+					      1, mode->pclk);
+
+	imx481->link_freq_ctrl = v4l2_ctrl_new_int_menu(ctrl_hdlr,
+							&imx481_ctrl_ops,
+							V4L2_CID_LINK_FREQ,
+							ARRAY_SIZE(link_freq) -
+							1,
+							mode->link_freq_idx,
+							link_freq);
+	if (imx481->link_freq_ctrl)
+		imx481->link_freq_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx481->hblank_ctrl = v4l2_ctrl_new_std(ctrl_hdlr,
+						&imx481_ctrl_ops,
+						V4L2_CID_HBLANK,
+						IMX481_REG_MIN,
+						IMX481_REG_MAX,
+						1, mode->hblank);
+	if (imx481->hblank_ctrl)
+		imx481->hblank_ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ret = v4l2_fwnode_device_parse(imx481->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &imx481_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		dev_err(imx481->dev, "control init failed: %d\n",
+			ret);
+		goto error_free_hdlr;
+	}
+
+	imx481->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+/**
+ * imx481_probe() - I2C client device binding
+ * @client: pointer to i2c client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+/*
+ * Power the focus actuator only while the sensor is powered: libcamera keeps
+ * the lens subdevice open, so powering it on open would hold the coil for as
+ * long as a camera app runs.
+ */
+static void imx481_link_lens(struct imx481 *imx481)
+{
+	struct device_node *np;
+	struct i2c_client *lens;
+
+	np = of_parse_phandle(imx481->dev->of_node, "lens-focus", 0);
+	if (!np)
+		return;
+	lens = of_find_i2c_device_by_node(np);
+	of_node_put(np);
+	if (!lens) {
+		dev_warn(imx481->dev, "focus actuator device not found\n");
+		return;
+	}
+
+	imx481->lens_link = device_link_add(imx481->dev, &lens->dev,
+					    DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME);
+	put_device(&lens->dev);
+	if (!imx481->lens_link)
+		dev_warn(imx481->dev, "could not link the focus actuator\n");
+}
+
+static int imx481_probe(struct i2c_client *client)
+{
+	struct imx481 *imx481;
+	const char *name;
+	int ret;
+
+	imx481 = devm_kzalloc(&client->dev, sizeof(*imx481), GFP_KERNEL);
+	if (!imx481)
+		return -ENOMEM;
+
+	imx481->dev = &client->dev;
+	name = device_get_match_data(&client->dev);
+	if (!name)
+		return -ENODEV;
+
+	/* Initialize subdev */
+	v4l2_i2c_subdev_init(&imx481->sd, client, &imx481_subdev_ops);
+	imx481->sd.internal_ops = &imx481_internal_ops;
+
+	ret = imx481_parse_hw_config(imx481);
+	if (ret) {
+		dev_err(imx481->dev, "HW configuration is not supported\n");
+		return ret;
+	}
+
+	mutex_init(&imx481->mutex);
+
+	ret = imx481_power_on(imx481->dev);
+	if (ret) {
+		dev_err(imx481->dev, "failed to power-on the sensor\n");
+		goto error_mutex_destroy;
+	}
+
+	/* Check module identity */
+	ret = imx481_detect(imx481);
+	if (ret) {
+		dev_err(imx481->dev, "failed to find sensor: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Set default mode to max resolution */
+	imx481->cur_mode = &supported_mode;
+	imx481->vblank = imx481->cur_mode->vblank;
+
+	ret = imx481_init_controls(imx481);
+	if (ret) {
+		dev_err(imx481->dev, "failed to init controls: %d\n", ret);
+		goto error_power_off;
+	}
+
+	/* Initialize subdev */
+	imx481->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx481->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	v4l2_i2c_subdev_set_name(&imx481->sd, client, name, NULL);
+
+	/* Initialize source pad */
+	imx481->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&imx481->sd.entity, 1, &imx481->pad);
+	if (ret) {
+		dev_err(imx481->dev, "failed to init entity pads: %d\n", ret);
+		goto error_handler_free;
+	}
+
+	ret = v4l2_async_register_subdev_sensor(&imx481->sd);
+	if (ret < 0) {
+		dev_err(imx481->dev,
+			"failed to register async subdev: %d\n", ret);
+		goto error_media_entity;
+	}
+
+	/* Linked before the status is set, which powers the lens with us. */
+	imx481_link_lens(imx481);
+
+	pm_runtime_set_active(imx481->dev);
+	pm_runtime_enable(imx481->dev);
+	pm_runtime_idle(imx481->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&imx481->sd.entity);
+error_handler_free:
+	v4l2_ctrl_handler_free(imx481->sd.ctrl_handler);
+error_power_off:
+	imx481_power_off(imx481->dev);
+error_mutex_destroy:
+	mutex_destroy(&imx481->mutex);
+
+	return ret;
+}
+
+/**
+ * imx481_remove() - I2C client device unbinding
+ * @client: pointer to I2C client device
+ *
+ * Return: 0 if successful, error code otherwise.
+ */
+static void imx481_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx481 *imx481 = to_imx481(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+
+	if (imx481->lens_link)
+		device_link_del(imx481->lens_link);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		imx481_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+
+	mutex_destroy(&imx481->mutex);
+}
+
+static const struct dev_pm_ops imx481_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx481_power_off, imx481_power_on, NULL)
+};
+
+static const struct of_device_id imx481_of_match[] = {
+	{ .compatible = "sony,imx481", .data = "imx481" },
+	{ }
+};
+
+MODULE_DEVICE_TABLE(of, imx481_of_match);
+
+static struct i2c_driver imx481_driver = {
+	.probe = imx481_probe,
+	.remove = imx481_remove,
+	.driver = {
+		.name = "imx481",
+		.pm = &imx481_pm_ops,
+		.of_match_table = imx481_of_match,
+	},
+};
+
+module_i2c_driver(imx481_driver);
+
+MODULE_DESCRIPTION("Sony IMX481 sensor driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/i2c/imx586.c b/drivers/media/i2c/imx586.c
--- /dev/null
+++ b/drivers/media/i2c/imx586.c
@@ -0,0 +1,1488 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Sony IMX586 camera sensor driver
+ *
+ * Copyright (C) 2021 Intel Corporation
+ * Copyright (C) 2026 OnePlus 7T Pro Linux contributors
+ */
+#include <linux/unaligned.h>
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+/* Streaming Mode */
+#define IMX586_REG_MODE_SELECT	0x0100
+#define IMX586_MODE_STANDBY	0x00
+#define IMX586_MODE_STREAMING	0x01
+
+/* Lines per frame */
+#define IMX586_REG_LPFR		0x0340
+
+/* Chip ID */
+#define IMX586_REG_ID		0x0016
+#define IMX586_ID		0x0586
+
+/* Exposure control */
+#define IMX586_REG_EXPOSURE_CIT	0x0202
+#define IMX586_EXPOSURE_MIN	6
+#define IMX586_EXPOSURE_OFFSET	48
+#define IMX586_EXPOSURE_STEP	1
+#define IMX586_EXPOSURE_DEFAULT	0x0bca
+
+/* Analog gain control */
+#define IMX586_REG_AGAIN	0x0204
+#define IMX586_AGAIN_MIN	0
+#define IMX586_AGAIN_MAX	992
+#define IMX586_AGAIN_STEP	1
+#define IMX586_AGAIN_DEFAULT	0x70
+
+/* Group hold register */
+#define IMX586_REG_HOLD		0x0104
+
+/* Input clock rate */
+#define IMX586_INCLK_RATE	19200000
+
+#define IMX586_VANA_MIN_UV	3300000
+#define IMX586_VANA_MAX_UV	3320000
+#define IMX586_VDIG_LOAD_UA	1100000
+
+/* CSI2 HW configuration */
+#define IMX586_LINK_FREQ	698395833
+#define IMX586_NUM_DATA_LANES	3
+
+#define IMX586_REG_MIN		0x00
+#define IMX586_REG_MAX		0xffff
+
+/**
+ * struct imx586_reg - imx586 sensor register
+ * @address: Register address
+ * @val: Register value
+ */
+struct imx586_reg {
+	u16 address;
+	u8 val;
+};
+
+/**
+ * struct imx586_reg_list - imx586 sensor register list
+ * @num_of_regs: Number of registers in the list
+ * @regs: Pointer to register list
+ */
+struct imx586_reg_list {
+	u32 num_of_regs;
+	const struct imx586_reg *regs;
+};
+
+/**
+ * struct imx586_mode - imx586 sensor mode structure
+ * @width: Frame width
+ * @height: Frame height
+ * @code: Format code
+ * @hblank: Horizontal blanking in lines
+ * @vblank: Vertical blanking in lines
+ * @vblank_min: Minimum vertical blanking in lines
+ * @vblank_max: Maximum vertical blanking in lines
+ * @pclk: Sensor pixel clock
+ * @link_freq_idx: Link frequency index
+ * @reg_list: Register list for sensor mode
+ */
+struct imx586_mode {
+	u32 width;
+	u32 height;
+	u32 code;
+	u32 hblank;
+	u32 vblank;
+	u32 vblank_min;
+	u32 vblank_max;
+	u64 pclk;
+	u32 link_freq_idx;
+	struct imx586_reg_list reg_list;
+};
+
+/**
+ * struct imx586 - imx586 sensor device structure
+ * @dev: Pointer to generic device
+ * @client: Pointer to i2c client
+ * @sd: V4L2 sub-device
+ * @pad: Media pad. Only one pad supported
+ * @reset_gpio: Sensor reset gpio
+ * @inclk: Sensor input clock
+ * @supplies: Regulator supplies
+ * @ctrl_handler: V4L2 control handler
+ * @link_freq_ctrl: Pointer to link frequency control
+ * @pclk_ctrl: Pointer to pixel clock control
+ * @hblank_ctrl: Pointer to horizontal blanking control
+ * @vblank_ctrl: Pointer to vertical blanking control
+ * @exp_ctrl: Pointer to exposure control
+ * @again_ctrl: Pointer to analog gain control
+ * @vblank: Vertical blanking in lines
+ * @cur_mode: Pointer to current selected sensor mode
+ * @mutex: Mutex for serializing sensor controls
+ */
+struct imx586 {
+	struct device *dev;
+	struct i2c_client *client;
+	struct device_link *lens_link;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *vana_enable_gpio;
+	struct gpio_desc *custom1_gpio;
+	struct gpio_desc *custom2_gpio;
+	struct clk *inclk;
+	struct regulator *vana;
+	struct regulator *vdig;
+	struct regulator *vio;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq_ctrl;
+	struct v4l2_ctrl *pclk_ctrl;
+	struct v4l2_ctrl *hblank_ctrl;
+	struct v4l2_ctrl *vblank_ctrl;
+	struct {
+		struct v4l2_ctrl *exp_ctrl;
+		struct v4l2_ctrl *again_ctrl;
+	};
+	u32 vblank;
+	const struct imx586_mode *cur_mode;
+	struct mutex mutex;
+};
+
+static const s64 link_freq[] = {
+	IMX586_LINK_FREQ,
+};
+
+/* Sensor mode registers */
+static const struct imx586_reg imx586_init_regs[] = {
+	{ 0x0136, 0x13 },
+	{ 0x0137, 0x33 },
+	{ 0x3c7e, 0x03 },
+	{ 0x3c7f, 0x0a },
+	{ 0x0111, 0x03 },
+	{ 0x380c, 0x00 },
