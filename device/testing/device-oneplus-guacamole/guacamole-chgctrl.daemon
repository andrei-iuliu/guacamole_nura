#!/usr/bin/env python3
"""Charge policy for the OnePlus 7 Pro on mainline.

The PM8150B charger (qcom_smbx) only knows BC1.2: it sets the USB input
current limit (ICL) from the detected SDP/CDP/DCP type and never looks at a
USB-PD contract or the battery temperature. This daemon adds the policy the
stock charger stack had:

  - USB PD: ICL from the negotiated contract (the connector sinks 5 V/3 A
    only; the board never passes 9 V through to the PMIC);
  - DCP wall chargers: 1.8 A, the stock usb-icl;
  - CDP: 1.5 A; SDP (a PC port): left to the USB gadget, which reports the
    configured bMaxPower to the charger (dwc3 usb-psy-name);
  - thermal throttling from the battery temperature, with a cold cutoff (the
    kernel has no JEITA taper, so the input is suspended instead of charging
    a cold pack at full current);
  - failing closed when the gauge data is missing, malformed or outside a
    plausible range: while the daemon runs, the input is suspended rather
    than charged at the last policy, and a failed read can never clear a
    latched thermal state (SIGTERM still resumes the input, as before);
  - an optional charge window (CHG_MIN/CHG_MAX) by suspending the input,
    for a phone that lives on a cable.

It publishes what the phone is charging from in /run/guacamole/charger (one
line, e.g. "pd 5000 3000 15.0 USB PD 5 V 3 A (15 W) | state=ok") and in the
journal on every change, and `guacamole-chgctrl status` prints it.

Warp Charge (the OnePlus 5 V/6 A protocol through the MCU at I2C 0x26) is
not supported: a Warp charger is driven as an ordinary DCP source.
"""
import os
import signal
import sys
import time

PSY = "/sys/class/power_supply"
CHARGER = PSY + "/pm8150b-charger"
BATTERY = PSY + "/bq27411-0"
TYPEC_PREFIX = "tcpm-source-psy-"
STATE_FILE = "/run/guacamole/charger"
CONF_FILE = "/etc/conf.d/guacamole-chgctrl"

ICL_PD_MAX_UA = 3000000     # charger input ceiling under a PD contract
ICL_DCP_UA = 1800000        # stock qcom,usb-icl-ua
ICL_CDP_UA = 1500000
ICL_SDP_UA = 500000         # USB 2 configured device
ICL_SDP_SS_UA = 900000      # USB 3 configured device
ICL_HOT_UA = 1000000        # stock thermal mitigation step
TEMP_WARM = 420             # 42.0 C: throttle
TEMP_HOT = 450              # 45.0 C: suspend input
TEMP_HYST = 20              # 2.0 C
# Cold cutoff. The kernel has no JEITA current taper, so below this the input
# is suspended instead of charging at the full 3 A/4.35 V policy. 5 C keeps a
# margin over gauge accuracy and cell self-heating; resume at 8 C for 3 C of
# hysteresis. This is a software policy choice, not a value measured on this
# unit; the boundary is covered by mocked tests only.
TEMP_COLD = 50              # 5.0 C: suspend input
TEMP_COLD_RESUME = 80       # 8.0 C: resume
# Plausibility window for the gauge. The bq27411 reports 0.1 C; a reading
# outside -40..125 C, or a missing/malformed one, is a failed read, not a
# temperature. Capacity is the gauge's state of charge, 0..100 %.
TEMP_MIN = -400
TEMP_MAX = 1250
CAP_MIN = 0
CAP_MAX = 100
POLL_S = 5


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def read_int(path, default=0):
    v = read(path)
    try:
        return int(v)
    except (TypeError, ValueError):
        return default


def plausible_temp(temp):
    return temp is not None and TEMP_MIN <= temp <= TEMP_MAX


def plausible_capacity(cap):
    return cap is not None and CAP_MIN <= cap <= CAP_MAX


def invalid_telemetry(temp, cap):
    """Names of the gauge readings that cannot be used for policy."""
    bad = []
    if not plausible_temp(temp):
        bad.append("temperature")
    if not plausible_capacity(cap):
        bad.append("capacity")
    return bad


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError as e:
        print("chgctrl: write %s=%s failed: %s" % (path, value, e), file=sys.stderr)
        return False


def load_conf():
    conf = {"CHG_MIN": 40, "CHG_MAX": 80, "KEEP_AWAKE": "yes", "CHG_SDP_UA": 0}
    try:
        for line in open(CONF_FILE):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            conf[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    for k in ("CHG_MIN", "CHG_MAX"):
        try:
            conf[k] = int(conf[k])
        except (TypeError, ValueError):
            conf[k] = 100 if k == "CHG_MAX" else 0
    for k in ("CHG_MIN", "CHG_MAX", "CHG_SDP_UA"):
        try:
            conf[k] = int(os.environ.get(k, conf[k]))
        except (TypeError, ValueError):
            conf[k] = 0
    return conf


def battery_percent():
    """The gauge's own state of charge, which is what the phone displays.

    It is voltage-aware: a loaded cell near 3.4 V reads 0 even when the
    remaining-charge counter still shows hundreds of mAh. The counters are
    only a fallback when the register is missing.
    """
    cap = read_int(BATTERY + "/capacity", -1)
    if cap >= 0:
        return cap
    now = read_int(BATTERY + "/charge_now", -1)
    full = read_int(BATTERY + "/charge_full", 0)
    if now >= 0 and full > 0:
        return min(100, max(0, now * 100 // full))
    return -1


def battery_temp():
    """Battery temperature in 0.1 C, or None when the read is unusable."""
    temp = read_int(BATTERY + "/temp", None)
    return temp if plausible_temp(temp) else None


def typec_psy():
    try:
        for name in os.listdir(PSY):
            if name.startswith(TYPEC_PREFIX):
                return PSY + "/" + name
    except OSError:
        pass
    return None


def selected(prop):
    """power_supply enum properties print 'a [b] c'; return the bracketed one."""
    v = read(prop, "")
    if "[" in v:
        return v[v.index("[") + 1:v.index("]")]
    return v


def sdp_limit_ua(conf):
    """Input limit the policy applies on a PC port."""
    return conf["CHG_SDP_UA"] or (ICL_SDP_SS_UA if gadget_superspeed() else ICL_SDP_UA)


def source(conf=None):
    """Classify the attached power source.

    Returns (kind, voltage_mv, current_ma, label). kind is one of
    none, sdp, cdp, dcp, pd.
    """
    # The charger reports online=0 while its input is suspended, so use the
    # Type-C port (independent of the input path) to tell "nothing attached"
    # from "attached but suspended".
    tc = typec_psy()
    attached = read_int(CHARGER + "/online") == 1 or (tc and read_int(tc + "/online") == 1)
    if not attached:
        return ("none", 0, 0, "Not connected")
    if tc and read_int(tc + "/online") == 1:
        t = selected(tc + "/usb_type")
        if t in ("PD", "PD_PPS"):
            mv = read_int(tc + "/voltage_now") // 1000 or read_int(tc + "/voltage_max") // 1000
            ma = read_int(tc + "/current_max") // 1000
            if ma > 0:
                w = mv * ma / 1000000
                return ("pd", mv, ma, "USB PD %g V %g A (%g W)" % (mv / 1000, ma / 1000, w))
    t = selected(CHARGER + "/usb_type")
    if t == "DCP":
        return ("dcp", 5000, ICL_DCP_UA // 1000, "USB wall charger (DCP) 5 V %g A" % (ICL_DCP_UA / 1e6))
    if t == "CDP":
        return ("cdp", 5000, ICL_CDP_UA // 1000, "USB CDP port 5 V 1.5 A")
    ma = (sdp_limit_ua(conf) if conf else
          (read_int(CHARGER + "/input_current_limit") or read_int(CHARGER + "/current_max"))) // 1000
    return ("sdp", 5000, ma, "USB port (SDP) 5 V %g A" % (ma / 1000))


def gadget_superspeed():
    try:
        for name in os.listdir("/sys/class/udc"):
            if read("/sys/class/udc/%s/current_speed" % name, "").startswith("super"):
                return True
    except OSError:
        pass
    return False


def publish(line):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        f.write(line + "\n")
    os.replace(tmp, STATE_FILE)


def cmd_status():
    kind, mv, ma, label = source(load_conf())
    print(label)
    cap = battery_percent()
    raw_temp = read_int(BATTERY + "/temp", None)
    print("battery: %s %s, %.2f V, %+.0f mA, %s" % (
        ("%d%%" % cap) if plausible_capacity(cap) else "capacity invalid",
        read(BATTERY + "/status"),
        read_int(BATTERY + "/voltage_now") / 1e6,
        read_int(BATTERY + "/current_now") / 1000,
        ("%.1f C" % (raw_temp / 10)) if plausible_temp(raw_temp)
        else "temperature invalid"))
    if kind != "none":
        print("input limit: %g A" % (read_int(CHARGER + "/input_current_limit") / 1e6))
    st = read(STATE_FILE)
    if st and " | " in st:
        print("policy: " + st.split(" | ", 1)[1])


def resume_input(*_):
    """Never leave the input suspended when the daemon stops."""
    write(CHARGER + "/status", 1)
    sys.exit(0)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "status":
        cmd_status()
        return
    signal.signal(signal.SIGTERM, resume_input)
    signal.signal(signal.SIGINT, resume_input)
    run(load_conf())


def run(conf, sleep=time.sleep):
    """Policy loop. sleep is injectable so tests can step it without sysfs."""
    suspended_by_window = False
    hot = False
    warm = False
    cold = False
    last_state = None
    last = None
    last_icl = None
    while True:
        kind, mv, ma, label = source(conf)
        cap = battery_percent()
        temp = battery_temp()

        # Thermal state with hysteresis. Only a usable temperature may move
        # the flags, so a failed read cannot clear a latched inhibition.
        if plausible_temp(temp):
            if temp >= TEMP_HOT:
                hot = True
            elif hot and temp < TEMP_HOT - TEMP_HYST:
                hot = False
            if temp >= TEMP_WARM:
                warm = True
            elif warm and temp < TEMP_WARM - TEMP_HYST:
                warm = False
            if temp <= TEMP_COLD:
                cold = True
            elif cold and temp >= TEMP_COLD_RESUME:
                cold = False
        invalid = not plausible_temp(temp) or not plausible_capacity(cap)
        if invalid:
            state = "invalid"
        elif hot:
            state = "hot"
        elif cold:
            state = "cold"
        elif warm:
            state = "warm"
        else:
            state = "ok"
        if state != last_state:
            if state == "invalid":
                detail = " (%s unusable)" % " and ".join(invalid_telemetry(temp, cap))
            elif state in ("hot", "cold", "warm"):
                detail = " (battery %.1f C)" % (temp / 10)
            else:
                detail = ""
            print("chgctrl: state %s -> %s%s" % (last_state or "start", state, detail),
                  flush=True)
            last_state = state

        # Charge window: stop at CHG_MAX, resume at CHG_MIN (100 disables). An
        # unusable capacity changes nothing; it suspends the input on its own.
        if kind != "none" and plausible_capacity(cap) and conf["CHG_MAX"] < 100:
            if not suspended_by_window and cap >= conf["CHG_MAX"]:
                suspended_by_window = True
            elif suspended_by_window and cap <= conf["CHG_MIN"]:
                suspended_by_window = False
        elif kind == "none":
            suspended_by_window = False

        suspend = kind != "none" and (hot or cold or invalid or suspended_by_window)
        reason = ""
        if kind != "none":
            if invalid:
                reason = "input suspended: gauge %s unusable" % (
                    " and ".join(invalid_telemetry(temp, cap)))
            elif hot:
                reason = "input suspended: battery %.1f C" % (temp / 10)
            elif cold:
                reason = "input suspended: battery %.1f C (cold cutoff)" % (temp / 10)
            elif suspended_by_window:
                reason = "input suspended: charge window %d-%d%%" % (conf["CHG_MIN"], conf["CHG_MAX"])
            elif warm:
                reason = "throttled to %g A: battery %.1f C" % (ICL_HOT_UA / 1e6, temp / 10)

        # Apply: input suspend through STATUS (0 suspends, 1 resumes), then the ICL.
        write(CHARGER + "/status", 0 if suspend else 1)
        icl = None
        if kind == "pd":
            icl = min(ma * 1000, ICL_PD_MAX_UA)
        elif kind == "dcp":
            icl = ICL_DCP_UA
        elif kind == "cdp":
            icl = ICL_CDP_UA
        elif kind == "sdp":
            # The gadget reports its allowance to the charger (dwc3
            # usb-psy-name), but its last report can be the 2 mA
            # unconfigured value; keep the configured USB 2/3 figure.
            icl = sdp_limit_ua(conf)
        if icl is not None and warm:
            icl = min(icl, ICL_HOT_UA)
        if icl is not None and not suspend and (icl != last_icl or kind == "sdp"):
            if write(CHARGER + "/input_current_limit", icl):
                last_icl = icl
        if kind == "none" or suspend:
            last_icl = None

        line = "%s %d %d %.1f %s" % (kind, mv, ma, mv * ma / 1e6, label)
        if kind != "none":
            line += " | state=%s%s" % (state, (": " + reason) if reason else "")
        if line != last:
            publish(line)
            print("chgctrl: " + line, flush=True)
            last = line
        sleep(POLL_S)


if __name__ == "__main__":
    main()
