From: Nura local rear-camera port
Subject: [PATCH] arm64 dts guacamole three rear cameras

Rebased on v7.0.0-sm8150 (8e126dbc), from Cube-Oakley/omarchy-mobile
f702f688288e59e3566f113d411ac7d18e4d0201. Original CAMSS patches
by Sr-0w; sensor and lens sources retain their authors and licenses.
See docs/REAR_CAMERA_7_0_BRINGUP.md for adaptations and limitations.

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -399,3 +399,7 @@
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-lenovo-thinkbook-16.dtb x1p42100-lenovo-thinkbook-16-el2.dtb
 x1p64100-microsoft-denali-el2-dtbs	:= x1p64100-microsoft-denali.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p64100-microsoft-denali.dtb x1p64100-microsoft-denali-el2.dtb
+
+dtb-$(CONFIG_ARCH_QCOM) += sm8150-oneplus-guacamole-rear-main.dtb
+dtb-$(CONFIG_ARCH_QCOM) += sm8150-oneplus-guacamole-rear-tele.dtb
+dtb-$(CONFIG_ARCH_QCOM) += sm8150-oneplus-guacamole-rear-wide.dtb
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-main.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-main.dts
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-main.dts
@@ -0,0 +1,4 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#define CAMERA_ISOLATE
+#define CAMERA_MAIN
+#include "sm8150-oneplus-guacamole.dts"
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-tele.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-tele.dts
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-tele.dts
@@ -0,0 +1,4 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#define CAMERA_ISOLATE
+#define CAMERA_TELE
+#include "sm8150-oneplus-guacamole.dts"
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-wide.dts b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-wide.dts
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear-wide.dts
@@ -0,0 +1,4 @@
+// SPDX-License-Identifier: BSD-3-Clause
+#define CAMERA_ISOLATE
+#define CAMERA_WIDE
+#include "sm8150-oneplus-guacamole.dts"
diff --git a/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear.dtsi b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear.dtsi
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8150-oneplus-guacamole-rear.dtsi
@@ -0,0 +1,564 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Rear-only static board integration, rebased from Cube-Oakley f702f688.
+ * Main/tele actuator suppliers are UNVERIFIED on this unit; no lens binding
+ * until identified. Ultrawide vendor variants both specify AK7374.
+ */
+#ifndef CAMERA_ISOLATE
+#define CAMERA_MAIN
+#define CAMERA_TELE
+#define CAMERA_WIDE
+#endif
+#include <dt-bindings/clock/qcom,gcc-sm8150.h>
+#include <dt-bindings/clock/qcom,sm8150-camcc.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interconnect/qcom,sm8150.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/media/video-interfaces.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+
+&tlmm {
+	cci0_default: cci0-default-state {
+		pins = "gpio17", "gpio18";
+		function = "cci_i2c";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	cci0_sleep: cci0-sleep-state {
+		pins = "gpio17", "gpio18";
+		function = "cci_i2c";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	cci1_default: cci1-default-state {
+		pins = "gpio19", "gpio20";
+		function = "cci_i2c";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	cci1_sleep: cci1-sleep-state {
+		pins = "gpio19", "gpio20";
+		function = "cci_i2c";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+#ifdef CAMERA_MAIN
+	cam_mclk1_default: cam-mclk1-default-state {
+		pins = "gpio14";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam0_vana_default: cam0-vana-default-state {
+		pins = "gpio11";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam0_custom1_default: cam0-custom1-default-state {
+		pins = "gpio29";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam0_reset_default: cam0-reset-default-state {
+		pins = "gpio30";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam0_vaf_default: cam0-vaf-default-state {
+		pins = "gpio25";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+#endif
+#ifdef CAMERA_TELE
+	cam_mclk0_default: cam-mclk0-default-state {
+		pins = "gpio13";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam1_reset_default: cam1-reset-default-state {
+		pins = "gpio28";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam1_vana_default: cam1-vana-default-state {
+		pins = "gpio148";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam1_vaf_default: cam1-vaf-default-state {
+		pins = "gpio35";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+#endif
+#ifdef CAMERA_WIDE
+	/* CCI1's two masters. */
+	cci3_default: cci3-default-state {
+		pins = "gpio33", "gpio34";
+		function = "cci_i2c";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	cci3_sleep: cci3-sleep-state {
+		pins = "gpio33", "gpio34";
+		function = "cci_i2c";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	cam_mclk3_default: cam-mclk3-default-state {
+		pins = "gpio16";
+		function = "cam_mclk";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam3_reset_default: cam3-reset-default-state {
+		pins = "gpio23";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+#endif
+};
+
+&{/} {
+#ifdef CAMERA_MAIN
+	vreg_cam0_vaf: regulator-cam0-vaf {
+		compatible = "regulator-fixed";
+		regulator-name = "cam0_vaf";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 25 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam0_vaf_default>;
+	};
+#endif
+#ifdef CAMERA_TELE
+	/* The telephoto's analogue rail: BOB through the GPIO148 switch. */
+	vreg_cam1_vana: regulator-cam1-vana {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1_vana";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 148 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_vana_default>;
+	};
+
+	/* Its autofocus rail: BOB through the GPIO35 switch. */
+	vreg_cam1_vaf: regulator-cam1-vaf {
+		compatible = "regulator-fixed";
+		regulator-name = "cam1_vaf";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&tlmm 35 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam1_vaf_default>;
+	};
+#endif
+#ifdef CAMERA_WIDE
+	/* The ultra-wide's autofocus rail: BOB through the PM8150L GPIO4 switch. */
+	vreg_cam3_vaf: regulator-cam3-vaf {
+		compatible = "regulator-fixed";
+		regulator-name = "cam3_vaf";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pm8150l_gpios 4 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam3_vaf_default>;
+	};
+#endif
+};
+
+#ifdef CAMERA_MAIN
+&pm8150l_gpios {
+	cam0_custom2_default: cam0-custom2-default-state {
+		pins = "gpio1";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
+};
+#endif
+#ifdef CAMERA_WIDE
+&pm8150l_gpios {
+	/* The ultra-wide's VANA gate, as stock (cam_sensor_rear_2_ana_active). */
+	cam3_vana_default: cam3-vana-default-state {
+		pins = "gpio2";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
+
+	/* Its VAF switch, as stock (cam_sensor_rear_2_af_active). */
+	cam3_vaf_default: cam3-vaf-default-state {
+		pins = "gpio4";
+		function = "normal";
+		power-source = <0>;
+		output-low;
+		input-disable;
+	};
+};
+#endif
+
+&{/soc@0/rsc@18200000/pm8009-rpmh-regulators} {
+	/* Sensor drivers preserve the reference VANA-before-VDIG order. */
+	vreg_l1f_1p1: ldo1 {
+		regulator-min-microvolt = <1104000>;
+		regulator-max-microvolt = <1104000>;
+		regulator-allow-set-load;
+		regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;
+	};
+
+
+	vreg_l4f_1p05: ldo4 {
+		regulator-min-microvolt = <1056000>;
+		regulator-max-microvolt = <1056000>;
+		regulator-allow-set-load;
+		regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM RPMH_REGULATOR_MODE_HPM>;
+	};
+#ifdef CAMERA_TELE
+	/* The telephoto's VDIG (vreg_l2f_1p2, 1.2 V at boot): stock asks 1.056 V. */
+	ldo2 {
+		regulator-min-microvolt = <1056000>;
+		regulator-max-microvolt = <1056000>;
+	};
+#endif
+};
+
+&soc {
+	cci0: cci@ac4a000 {
+		compatible = "qcom,sm8150-cci", "qcom,sdm845-cci";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		reg = <0 0x0ac4a000 0 0x1000>;
+		interrupts = <GIC_SPI 460 IRQ_TYPE_EDGE_RISING>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_CORE_AHB_CLK>,
+			 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
+			 <&camcc CAM_CC_CPAS_AHB_CLK>,
+			 <&camcc CAM_CC_CCI_0_CLK>,
+			 <&camcc CAM_CC_CCI_0_CLK_SRC>;
+		clock-names = "camnoc_axi", "soc_ahb", "slow_ahb_src", "cpas_ahb", "cci", "cci_src";
+		assigned-clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>, <&camcc CAM_CC_CCI_0_CLK>;
+		assigned-clock-rates = <80000000>, <37500000>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cci0_default &cci1_default>;
+		pinctrl-1 = <&cci0_sleep &cci1_sleep>;
+
+		cci0_i2c0: i2c-bus@0 {
+			reg = <0>;
+			clock-frequency = <1000000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+#ifdef CAMERA_TELE
+			s5k3m5_vcm: lens@74 {
+				/* Supplier unverified: do not power or move this actuator. */
+				status = "disabled";
+				compatible = "onnn,lc898217xc";
+				reg = <0x74>;
+				vdd-supply = <&vreg_cam1_vaf>;
+				vio-supply = <&vreg_l1c_1p8>;
+			};
+
+			/* Rear telephoto. */
+			camera@10 {
+				compatible = "samsung,s5k3m5";
+				reg = <0x10>;
+				orientation = <1>;
+				rotation = <90>;
+
+				clocks = <&camcc CAM_CC_MCLK0_CLK>;
+				assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+				assigned-clock-rates = <24000000>;
+
+				/* Brought up in this order by our driver: AF, VANA, VDIG, VIO. */
+				afvdd-supply = <&vreg_bob>;
+				vdda-supply = <&vreg_cam1_vana>;
+				vddd-supply = <&vreg_l2f_1p2>;
+				vddio-supply = <&vreg_l1c_1p8>;
+
+				reset-gpios = <&tlmm 28 GPIO_ACTIVE_LOW>;
+				/* lens-focus awaits this unit's actuator identification. */
+				pinctrl-names = "default";
+				pinctrl-0 = <&cam_mclk0_default>, <&cam1_reset_default>;
+
+				port {
+					s5k3m5_ep: endpoint {
+						bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+						data-lanes = <0 1 2 3>;
+						link-frequencies = /bits/ 64 <602500000>;
+						remote-endpoint = <&csiphy0_ep>;
+					};
+				};
+			};
+#endif
+		};
+
+		cci0_i2c1: i2c-bus@1 {
+			reg = <1>;
+			/* The stock actuator setup on this master needs FAST mode. */
+			clock-frequency = <400000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+#ifdef CAMERA_MAIN
+			imx586_vcm: lens@72 {
+				/* Supplier unverified: do not power or move this actuator. */
+				status = "disabled";
+				compatible = "onnn,lc898217xc";
+				reg = <0x72>;
+				vdd-supply = <&vreg_cam0_vaf>;
+				vio-supply = <&vreg_l1c_1p8>;
+			};
+
+			/* Main 48 MP rear camera. */
+			camera@1a {
+				compatible = "sony,imx586";
+				reg = <0x1a>;
+				orientation = <1>;
+				rotation = <90>;
+
+				clocks = <&camcc CAM_CC_MCLK1_CLK>;
+				assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
+				assigned-clock-rates = <19200000>;
+
+				vio-supply = <&vreg_l1c_1p8>;
+				vana-supply = <&vreg_bob>;
+				vdig-supply = <&vreg_l1f_1p1>;
+
+				reset-gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
+				vana-enable-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
+				custom1-gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
+				custom2-gpios = <&pm8150l_gpios 1 GPIO_ACTIVE_HIGH>;
+				/* lens-focus awaits this unit's actuator identification. */
+				pinctrl-names = "default";
+				pinctrl-0 = <&cam_mclk1_default>, <&cam0_vana_default>,
+					    <&cam0_custom1_default>, <&cam0_custom2_default>,
+					    <&cam0_reset_default>;
+
+				port {
+					imx586_ep: endpoint {
+						bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+						data-lanes = <0 1 2>;
+						link-frequencies = /bits/ 64 <698395833>;
+						remote-endpoint = <&csiphy1_ep>;
+					};
+				};
+			};
+#endif
+		};
+	};
+
+#ifdef CAMERA_WIDE
+	cci1: cci@ac4b000 {
+		compatible = "qcom,sm8150-cci", "qcom,sdm845-cci";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		reg = <0 0x0ac4b000 0 0x1000>;
+		interrupts = <GIC_SPI 271 IRQ_TYPE_EDGE_RISING>;
+		power-domains = <&camcc TITAN_TOP_GDSC>;
+
+		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_CORE_AHB_CLK>,
+			 <&camcc CAM_CC_SLOW_AHB_CLK_SRC>,
+			 <&camcc CAM_CC_CPAS_AHB_CLK>,
+			 <&camcc CAM_CC_CCI_1_CLK>,
+			 <&camcc CAM_CC_CCI_1_CLK_SRC>;
+		clock-names = "camnoc_axi", "soc_ahb", "slow_ahb_src", "cpas_ahb", "cci", "cci_src";
+		assigned-clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>, <&camcc CAM_CC_CCI_1_CLK>;
+		assigned-clock-rates = <80000000>, <37500000>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&cci3_default>;
+		pinctrl-1 = <&cci3_sleep>;
+
+
+		cci1_i2c1: i2c-bus@1 {
+			reg = <1>;
+			clock-frequency = <1000000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			imx481_vcm: lens@c {
+				compatible = "asahi-kasei,ak7374";
+				reg = <0x0c>;
+				vdd-supply = <&vreg_cam3_vaf>;
+				vio-supply = <&vreg_l1c_1p8>;
+			};
+
+			/* Rear ultra-wide. */
+			camera@1a {
+				compatible = "sony,imx481";
+				reg = <0x1a>;
+				orientation = <1>;
+				rotation = <90>;
+
+				clocks = <&camcc CAM_CC_MCLK3_CLK>;
+				assigned-clocks = <&camcc CAM_CC_MCLK3_CLK>;
+				assigned-clock-rates = <19200000>;
+
+				/* The driver brings up VANA, VDIG, then VIO. */
+				vio-supply = <&vreg_l1c_1p8>;
+				vana-supply = <&vreg_bob>;
+				vdig-supply = <&vreg_l4f_1p05>;
+
+				reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
+				vana-enable-gpios = <&pm8150l_gpios 2 GPIO_ACTIVE_HIGH>;
+				lens-focus = <&imx481_vcm>;
+				pinctrl-names = "default";
+				pinctrl-0 = <&cam_mclk3_default>, <&cam3_reset_default>,
+					    <&cam3_vana_default>;
+
+				port {
+					imx481_ep: endpoint {
+						bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+						data-lanes = <0 1 2 3>;
+						link-frequencies = /bits/ 64 <654075000>;
+						remote-endpoint = <&csiphy3_ep>;
+					};
+				};
+			};
+		};
+	};
+#endif
+
+	camss: camss@acb3000 {
+		compatible = "qcom,sm8150-camss";
+		reg = <0 0x0acb3000 0 0x1000>, <0 0x0acba000 0 0x1000>,
+		      <0 0x0ac65000 0 0x1000>, <0 0x0ac66000 0 0x1000>,
+		      <0 0x0ac67000 0 0x1000>, <0 0x0ac68000 0 0x1000>,
+		      <0 0x0acaf000 0 0x4000>, <0 0x0acb6000 0 0x4000>;
+		reg-names = "csid0", "csid1", "csiphy0", "csiphy1", "csiphy2", "csiphy3", "vfe0", "vfe1";
+		interrupts = <GIC_SPI 464 IRQ_TYPE_EDGE_RISING>, <GIC_SPI 466 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>, <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>, <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
+			     <GIC_SPI 465 IRQ_TYPE_EDGE_RISING>, <GIC_SPI 467 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "csid0", "csid1", "csiphy0", "csiphy1", "csiphy2", "csiphy3", "vfe0", "vfe1";
+		power-domains = <&camcc IFE_0_GDSC>, <&camcc IFE_1_GDSC>, <&camcc TITAN_TOP_GDSC>;
+		power-domain-names = "ife0", "ife1", "top";
+		clocks = <&camcc CAM_CC_CAMNOC_AXI_CLK>,
+			 <&camcc CAM_CC_CPAS_AHB_CLK>,
+			 <&camcc CAM_CC_CPHY_RX_CLK_SRC>,
+			 <&camcc CAM_CC_IFE_0_CSID_CLK>,
+			 <&camcc CAM_CC_IFE_0_CSID_CLK_SRC>,
+			 <&camcc CAM_CC_IFE_1_CSID_CLK>,
+			 <&camcc CAM_CC_IFE_1_CSID_CLK_SRC>,
+			 <&camcc CAM_CC_CSIPHY0_CLK>,
+			 <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
+			 <&camcc CAM_CC_CSI0PHYTIMER_CLK_SRC>,
+			 <&camcc CAM_CC_CSIPHY1_CLK>,
+			 <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
