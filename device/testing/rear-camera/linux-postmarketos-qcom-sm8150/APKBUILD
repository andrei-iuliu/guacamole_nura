# Nura rear-camera candidate; release 7.0.0-sm8150-rear1.
# Nura-local v7.0.0-sm8150 port.  This recipe is isolated from the
# 6.17 package in device/testing/linux-postmarketos-qcom-sm8150 and from
# the official 7.0.0-r2 recipe: it adds the 6.17 board carries that are not
# yet upstream.  See docs/SM8150_7_0_BRINGUP.md.
# Co-Maintainer: Viola Guerrera <guerrera.nicola@gmail.com>
maintainer="Pan Ortiz <panjeoc@proton.me>"
_flavor="postmarketos-qcom-sm8150"
pkgname=linux-$_flavor
pkgver=7.0.0
pkgrel=3
pkgdesc="Mainline Kernel fork for SM8150 devices"
arch="aarch64"
_carch="arm64"
url="https://gitlab.postmarketos.org/soc/qualcomm-sm8150/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
