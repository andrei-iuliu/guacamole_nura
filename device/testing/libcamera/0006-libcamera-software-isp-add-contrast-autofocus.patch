--- /dev/null
+++ b/src/ipa/softisp/algorithms/af.cpp
@@ -0,0 +1,300 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Contrast autofocus for the software ISP
+ *
+ * A coarse-to-fine contrast scan over the lens range, driven by the
+ * exposure-normalized green edge energy the CPU statistics collect. It waits
+ * for the exposure loop to settle before scanning, holds the lens at the
+ * sharpest position found, and in continuous mode rescans when the sharpness
+ * at the locked position drops.
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <cmath>
+#include <stdint.h>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/log.h>
+
+#include "control_ids.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftIspAf)
+
+namespace ipa::softisp::algorithms {
+
+/* Consecutive stats frames without an exposure change before a scan starts. */
+static constexpr unsigned int kAeStableSamples = 3;
+/* Start the scan anyway after this many stats frames with a pending scan. */
+static constexpr unsigned int kAeSettleTimeoutSamples = 12;
+/* Stats frames to hold a lock before continuous mode may rescan. */
+static constexpr unsigned int kContinuousMonitorDelaySamples = 15;
+
+int Af::init(IPAContext &context,
+	     [[maybe_unused]] const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, controls::AfModeContinuous);
+	context.ctrlMap[&controls::AfTrigger] =
+		ControlInfo(controls::AfTriggerValues);
+	/*
+	 * The actuator has no calibrated DAC-to-dioptre curve. Expose a
+	 * normalized manual range until that calibration is available.
+	 */
+	context.ctrlMap[&controls::LensPosition] =
+		ControlInfo(0.0f, 1.0f, 1.0f);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto lens = configInfo.lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (lens == configInfo.lensControls.end()) {
+		context.configuration.focus.available = false;
+		LOG(IPASoftIspAf, Debug) << "No focus lens control available";
+		return 0;
+	}
+
+	context.configuration.focus.available = true;
+	context.configuration.focus.min = lens->second.min().get<int32_t>();
+	context.configuration.focus.max = lens->second.max().get<int32_t>();
+
+	const int32_t range = std::max(1, context.configuration.focus.max -
+						  context.configuration.focus.min);
+	context.configuration.focus.coarseStep = std::max(1, range / 4);
+	context.configuration.focus.fineStep = std::max(1, range / 20);
+
+	auto &af = context.activeState.af;
+	af.mode = controls::AfModeContinuous;
+	af.state = controls::AfStateScanning;
+	af.position = lens->second.def().get<int32_t>();
+	af.scanning = false;
+	af.pendingScan = true;
+	af.aeStableSamples = 0;
+	af.pendingSamples = 0;
+	af.lastExposure = 0;
+	af.lastGain = 0.0;
+
+	LOG(IPASoftIspAf, Info)
+		<< "Focus range " << context.configuration.focus.min << "-"
+		<< context.configuration.focus.max << ", steps "
+		<< context.configuration.focus.coarseStep << "/"
+		<< context.configuration.focus.fineStep;
+
+	return 0;
+}
+
+void Af::startScan(IPAContext &context)
+{
+	if (!context.configuration.focus.available)
+		return;
+
+	auto &af = context.activeState.af;
+	af.pendingScan = false;
+	af.scanning = true;
+	af.fineScan = false;
+	af.state = controls::AfStateScanning;
+	af.scanStart = context.configuration.focus.min;
+	af.scanEnd = context.configuration.focus.max;
+	af.scanStep = context.configuration.focus.coarseStep;
+	af.position = af.scanStart;
+	af.bestPosition = af.position;
+	af.bestSharpness = 0;
+	af.settleSamples = 1;
+	af.lowSharpnessSamples = 0;
+	af.pendingSamples = 0;
+
+	LOG(IPASoftIspAf, Debug) << "Starting autofocus scan";
+}
+
+void Af::queueRequest(IPAContext &context,
+		      [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &requestControls)
+{
+	if (!context.configuration.focus.available)
+		return;
+
+	auto &af = context.activeState.af;
+
+	if (const auto mode = requestControls.get(controls::AfMode)) {
+		if (*mode != af.mode) {
+			af.mode = *mode;
+			if (af.mode == controls::AfModeContinuous) {
+				af.pendingScan = true;
+				af.scanning = false;
+				af.state = controls::AfStateScanning;
+			} else {
+				af.pendingScan = false;
+				af.scanning = false;
+				af.state = controls::AfStateIdle;
+			}
+		}
+	}
+
+	if (af.mode == controls::AfModeManual) {
+		af.pendingScan = false;
+		af.scanning = false;
+		if (const auto position = requestControls.get(controls::LensPosition)) {
+			const float normalized = std::clamp(*position, 0.0f, 1.0f);
+			const int32_t range = context.configuration.focus.max -
+					      context.configuration.focus.min;
+			af.position = context.configuration.focus.min +
+				      std::lround(normalized * range);
+		}
+		return;
+	}
+
+	if (af.mode != controls::AfModeAuto)
+		return;
+
+	if (const auto trigger = requestControls.get(controls::AfTrigger)) {
+		if (*trigger == controls::AfTriggerStart && !af.scanning &&
+		    !af.pendingScan) {
+			af.pendingScan = true;
+			af.state = controls::AfStateScanning;
+		} else if (*trigger == controls::AfTriggerCancel &&
+			   (af.scanning || af.pendingScan)) {
+			af.pendingScan = false;
+			af.scanning = false;
+			af.state = controls::AfStateIdle;
+		}
+	}
+}
+
+/*
+ * Count stats frames for which the exposure loop requested the same exposure
+ * and gain as for the previous one. The AGC runs before this algorithm, so
+ * frameContext.agc carries this frame's request.
+ */
+void Af::trackExposure(IPAContext &context, const IPAFrameContext &frameContext)
+{
+	auto &af = context.activeState.af;
+
+	if (frameContext.agc.exposure == af.lastExposure &&
+	    frameContext.agc.gain == af.lastGain) {
+		af.aeStableSamples = std::min(af.aeStableSamples + 1, 100U);
+	} else {
+		af.aeStableSamples = 0;
+		af.lastExposure = frameContext.agc.exposure;
+		af.lastGain = frameContext.agc.gain;
+	}
+}
+
+void Af::processScan(IPAContext &context, uint64_t sharpness)
+{
+	auto &af = context.activeState.af;
+
+	if (af.settleSamples) {
+		--af.settleSamples;
+		return;
+	}
+
+	LOG(IPASoftIspAf, Debug)
+		<< (af.fineScan ? "Fine" : "Coarse")
+		<< " focus sample at " << af.position
+		<< " (sharpness " << sharpness << ")";
+
+	if (sharpness > af.bestSharpness) {
+		af.bestSharpness = sharpness;
+		af.bestPosition = af.position;
+	}
+
+	if (af.position + af.scanStep <= af.scanEnd) {
+		af.position += af.scanStep;
+		af.settleSamples = 1;
+		return;
+	}
+
+	if (!af.fineScan) {
+		const int32_t radius = context.configuration.focus.coarseStep;
+		af.fineScan = true;
+		af.scanStart = std::max(context.configuration.focus.min,
+					af.bestPosition - radius);
+		af.scanEnd = std::min(context.configuration.focus.max,
+				      af.bestPosition + radius);
+		af.scanStep = context.configuration.focus.fineStep;
+		af.position = af.scanStart;
+		af.bestSharpness = 0;
+		af.settleSamples = 1;
+		return;
+	}
+
+	af.scanning = false;
+	af.position = af.bestPosition;
+	af.lockedSharpness = af.bestSharpness;
+	af.state = af.bestSharpness ? controls::AfStateFocused
+				    : controls::AfStateFailed;
+	af.settleSamples = kContinuousMonitorDelaySamples;
+
+	LOG(IPASoftIspAf, Info)
+		<< "Autofocus completed at " << af.position
+		<< " (sharpness " << af.bestSharpness << ")";
+}
+
+float Af::normalizedPosition(const IPAContext &context) const
+{
+	const auto &focus = context.configuration.focus;
+	const int32_t range = focus.max - focus.min;
+	if (!range)
+		return 0.0f;
+
+	return static_cast<float>(context.activeState.af.position - focus.min) /
+	       range;
+}
+
+void Af::process(IPAContext &context,
+		 [[maybe_unused]] const uint32_t frame,
+		 IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	auto &af = context.activeState.af;
+
+	if (!context.configuration.focus.available)
+		return;
+
+	if (stats->valid) {
+		trackExposure(context, frameContext);
+
+		if (af.pendingScan) {
+			af.pendingSamples++;
+			if (af.aeStableSamples >= kAeStableSamples ||
+			    af.pendingSamples >= kAeSettleTimeoutSamples)
+				startScan(context);
+		}
+
+		if (af.scanning) {
+			processScan(context, stats->sharpness);
+		} else if (af.mode == controls::AfModeContinuous &&
+			   af.state == controls::AfStateFocused &&
+			   !af.settleSamples && af.lockedSharpness &&
+			   stats->sharpness * 100 < af.lockedSharpness * 65) {
+			if (++af.lowSharpnessSamples >= 3) {
+				af.pendingScan = true;
+				af.state = controls::AfStateScanning;
+				af.lowSharpnessSamples = 0;
+			}
+		} else {
+			af.lowSharpnessSamples = 0;
+			if (af.settleSamples)
+				--af.settleSamples;
+		}
+	}
+
+	frameContext.lens.position = af.position;
+	metadata.set(controls::AfMode, af.mode);
+	metadata.set(controls::AfState, af.state);
+	metadata.set(controls::LensPosition, normalizedPosition(context));
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::softisp::algorithms */
+
+} /* namespace libcamera */
